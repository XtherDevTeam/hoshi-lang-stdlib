use net "net"
use str "str"
use console "console"
use runtime "runtime"
use kiana "kiana"
use http "net/http"
use hashMap "hashMap"
use json "json"
use fs "fs"
use file "file"
use jwt "jwt"
use time "time"

func root(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let body = str.Str("
        <!doctype html>
        <html>
            <head></head>
            <body>
                <div class=\"a\">琪亚娜，出击！</div>
                <div class=\"b\">Hello, hoshi-lang http-server!</div>
            </body>
            <style>
            .a {
                background-image: -webkit-linear-gradient(bottom,red,yellow,black); 
                font-weight: bolder;
                font-size: 8rem;
                font-style: italic;
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .b {
                margin-left: 100px;
                background-image: -webkit-linear-gradient(bottom,silver,gray,white); 
                font-weight: bolder;
                font-size: 8rem;
                font-style: italic;
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            </style>
        </html>
    ")
    let headers = http.HTTPResponseHeader("HTTP/1.1", 200, "OK")
                        .add_header("Content-Type", "text/html; charset=UTF-8")
    return kiana.response.Response(headers, body)
}

func json_test(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let body = json.parse("{\"a\": \"Hello, world!\", \"b\": [1, 2, 3], \"c\": null}").unwrap()
    return kiana.response.Response(http.HTTPResponseHeader("HTTP/1.1", 200, "OK"), body)
}

func file_test(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let f = fs.open("/Users/chou/Downloads/The Graduation Trip.7z", "rb")
    if (f.is_err()) {
        return kiana.response.Response(http.HTTPResponseHeader("HTTP/1.1", 404, "Not Found"), str.Str("File not found"))
    }
    let fi = f.unwrap() as file.AbstractFile
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK")
            .add_header("Content-Type", "application/octet-stream")
            .add_header("Content-Disposition", "attachment; filename=\"The Graduation Trip.7z\""), 
        fi
    )
}

func jwt_cookie_set(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let session = jwt.JWTBuilder(jwt.HMACSHA256("kiana"))
        .add_claim("valkeryie", str.Str("Kiana Kaslana"))
        .add_claim("host_time", str.Stringable(time.Date.now() + time.Duration.timezone()).to_string())
        .yield()
    let cookie = kiana.cookie.Cookie()
        .put("session_token", str.Stringable(session).to_string())
        .path("/")
        .http_only(true)
        .max_age(time.Duration.days(30))
    let headers = http.HTTPResponseHeader("HTTP/1.1", 200, "OK")
                    .set_cookie(str.Stringable(cookie).to_string())
                    .add_header("Content-Type", "text/html; charset=UTF-8")
    let html : str.Str = "
        <!doctype html>
        <html>
            <head>
                <title>Set JWT cookie success</title>
            </head>
            <body>
                <div>Set JWT cookie success!</div>
            </body>
        </html>
    "
    return kiana.response.Response(headers, html)
}

func jwt_cookie_view(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    if (req.headers.headers.contains("cookie") == false) {
        return kiana.response.Response(http.HTTPResponseHeader("HTTP/1.1", 404, "Not Found", hashMap.HashMap<str.Str, str.Str>()), str.Str("Cookie not found"))
    }
    let cookie = kiana.cookie.parse(req.headers.headers["cookie"])
    let token = jwt.extract_payload(jwt.parse(cookie.get("session_token")).unwrap(), jwt.HMACSHA256("kiana"))
    if (token.is_err()) {
        return kiana.response.Response(http.HTTPResponseHeader("HTTP/1.1", 404, "Not Found", hashMap.HashMap<str.Str, str.Str>()), str.Str("Invalid token"))
    }
    let valkeryie = dyn_cast<str.Str>(token.unwrap()["valkeryie"])
    let host_time = dyn_cast<str.Str>(token.unwrap()["host_time"])

    let headers = http.HTTPResponseHeader("HTTP/1.1", 200, "OK").add_header("Content-Type", "text/html; charset=UTF-8")
    let html : str.Str = "
        <!doctype html>
        <html>
            <head>
                <title>View JWT cookie success</title>
            </head>
            <body>
                <div>View JWT cookie success!</div>
                <div>Valkeryie: {}</div>
                <div>Host time: {}</div>
            </body>
        </html>
    "
    return kiana.response.Response(headers, str.format(html, valkeryie, host_time))
}

func error_route() : kiana.response.Response {
    return kiana.response.Response(http.HTTPResponseHeader("HTTP/1.1", 404, "NOT FOUND").add_header("Content-Type", "text/plain; charset=UTF-8"), str.Str("页面被 Kiana 吃掉了喵～"))
}

func upload_test(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    req.form_data(func[](name: str.Str, reader: kiana.request.FormDataReader) : none {
        if (reader.headers.contains("content-disposition")) {
            let cd = reader.headers["content-disposition"]
            let filename_index = cd.find("filename=\"")
            if (filename_index != -1) {
                let filename_end = cd.find("\"", filename_index + 10)
                if (filename_end != -1) {
                    let filename = cd.substring(filename_index + 10, filename_end)
                    console.print("Uploading file: ", filename, "\n")
                    reader.save_as(filename)
                    console.print("Saved file: ", filename, "\n")
                }
            }
        }
    })
    return kiana.response.Response(http.HTTPResponseHeader("HTTP/1.1", 200, "OK"), str.Str("Upload success"))
}

func upload_page(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let body = str.Str("
        <!doctype html>
        <html>
            <head>
                <title>Tsuki File Upload</title>
                <style>
                    body { font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; background-color: #f0f2f5; }
                    .upload-container { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center; }
                    h1 { color: #1a73e8; }
                    input[type=\"file\"] { margin: 1rem 0; }
                    button { background-color: #1a73e8; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; }
                    button:hover { background-color: #1557b0; }
                </style>
            </head>
            <body>
                <div class=\"upload-container\">
                    <h1>Upload File</h1>
                    <form action=\"/upload\" method=\"post\" enctype=\"multipart/form-data\">
                        <input type=\"file\" name=\"file\" />
                        <br/>
                        <button type=\"submit\">Upload</button>
                    </form>
                </div>
            </body>
        </html>
    ")
    let headers = http.HTTPResponseHeader("HTTP/1.1", 200, "OK")
                        .add_header("Content-Type", "text/html; charset=UTF-8")
    return kiana.response.Response(headers, body)
}

func main() : int {
    console.print("net-http-server: start\n")
    let app = kiana.application.Application(kiana.application.ApplicationConfig("0.0.0.0", 9002))
    app.use_route("/", func root)
    app.use_route("/json", func json_test)
    app.use_route("/file", func file_test)
    app.use_route("/jwt/set", func jwt_cookie_set)
    app.use_route("/jwt/view", func jwt_cookie_view)
    app.use_route("/upload", func upload_test)
    app.use_route("/upload_page", func upload_page)
    app.use_error_endpoint(404, func error_route)
    let rc = app.serve()
    console.print("net-http-server: exit with code", rc as int, "\n")
    return 0
}