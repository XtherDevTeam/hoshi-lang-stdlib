use cookie "net/cookie"
use sqlite_backend "net/sqlite_cookie_backend"
use console "console"
use time "time"
use str "str"
use fs "fs"

func main() : int {
    let db_path = "test_cookies.db"
    fs.Path(db_path).remove()
    let backend_res = sqlite_backend.SqliteCookieBackend.from_path(db_path)
    if (backend_res.is_err()) {
        console.print("Failed to create backend: ", backend_res.unwrap_err(), "\n")
        return 1
    }
    let backend = backend_res.unwrap()
    let jar = cookie.Cookies(backend)
    
    // Add a manual cookie
    let section = cookie.CookieSection()
    section.key("test_key")
           .value("test_value")
           .domain("example.com")
           .path("/")
           .expires(time.Date.from_timestamp(time.Date.now().time.seconds + 3600))
           .secure(true)
           .http_only(true)
    
    // Add an expired cookie
    let expired_section = cookie.CookieSection()
    expired_section.key("expired_key")
           .value("expired_value")
           .domain("example.com")
           .path("/")
           .expires(time.Date.from_timestamp(time.Date.now().time.seconds - 3600))
           .secure(true)
           .http_only(true)
    
    console.print("Adding cookies for example.com (one valid, one expired)\n")
    jar.put(section)
    jar.put(expired_section)
    jar.save()
    
    console.print("Retrieving cookies for example.com: ", jar.get_cookies("example.com"), "\n")
    
    // Test deserialization from a new instance
    console.print("Testing persistence and expiration filtering...\n")
    let backend_res2 = sqlite_backend.SqliteCookieBackend.from_path(db_path)
    if (backend_res2.is_err()) {
        console.print("Failed to create second backend instance\n")
        return 1
    }
    let jar2 = cookie.Cookies(backend_res2.unwrap())
    let results = jar2.get_cookies("example.com")
    console.print("Retrieved cookies after reload: ", results, "\n")
    
    if (results.find("test_key=test_value") != -1 && results.find("expired_key=expired_value") == -1) {
        console.print("Verification successful: Expired cookie was filtered out!\n")
    } else {
        console.print("Verification failed: filtering did not work as expected\n")
        if (results.find("expired_key=expired_value") != -1) {
            console.print("Error: Expired cookie was found in the results.\n")
        }
    }
    
    return 0
}
