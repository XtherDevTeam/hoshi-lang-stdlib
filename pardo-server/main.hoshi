use console "console"
use runtime "runtime"
use kiana "kiana"
use http "net/http"
use hashMap "hashMap"
use json "json"
use fs "fs"
use file "file"
use jwt "jwt"
use time "time"
use dataProvider "share/dataProvider"
use context "share/context"
use types "share/types"
use vec "vec"
use lang "builtin"

let pcontext : context.PardoServerContext = null
let application : kiana.application.Application = null
let data_provider : dataProvider.DataProvider = null
let public_routes = hashMap.HashMap<str.Str, str.Str>()
    .put("/", "full-match")
    .put("/index", "starts-with")
    .put("/v1/user/login", "full-match")
    .put("/v1/package/list", "full-match")
    .put("/v1/package/info", "full-match")
    .put("/v1/package/version/list", "full-match")
    .put("/v1/package/version/info", "full-match")

func check_admin_status() : none {
    let [_, err] = data_provider.get_user_by_username("jerry_chou")
    if (err != null) {
        pcontext.logger.log("No admin user found, creating one...")
        if (data_provider.add_user("jerry_chou", "<placeholder>") != dataProvider.ResultCode.Success) {
            pcontext.logger.error("Failed to create admin user: unable to add user")
            pcontext.logger.error(data_provider.db.error_message())
            return
        }

        let [user, err] = data_provider.get_user_by_username("jerry_chou")
        if (err != null) {
            pcontext.logger.error("Failed to create admin user")
            return
        }
            
        data_provider.update_user_password(user.id, console.input("Enter admin password:").trim())

        data_provider.update_user(
            user.id,
            "May all the beauty be blessed.",
            "zhouyongkang4321@gmail.com",
            types.Permission.Administrator
        )
        pcontext.logger.log("Admin user created")
    }
}

func make_error_response(message: str.Str) : kiana.response.Response {
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("error"))
            .put("message", message) as json.JSONValue
    )
}

func get_current_user_id(req: kiana.request.Request) : lang.Result<int, str.Str> {
    if (req.headers.headers.contains("cookie") == false) {
        return lang.Result<int, str.Str>.err("missing cookie")
    }
    let cookie = kiana.cookie.parse(req.headers.headers["cookie"])
    if (cookie == null || cookie.get("pardo_session") == null || cookie.get("pardo_session").trim() == "") {
        return lang.Result<int, str.Str>.err("missing session")
    }
    let [token, err] = jwt.extract_payload(jwt.parse(cookie.get("pardo_session")).unwrap(), jwt.HMACSHA256(pcontext.config.secret_key))
    if (err != null) {
        return lang.Result<int, str.Str>.err("invalid token")
    }
    let jwtoken = types.PardoJWTClaims.from_json(token)
    return lang.Result<int, str.Str>.ok(jwtoken.user)
}

// /
func route_root(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("server", str.Str("pardo-package-manager-remote-server"))
            .put("api", json.Numeric(1))
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

func post_authentication(req: kiana.request.Request) : lang.Result<kiana.request.Request, kiana.response.Response> {
    let check_if_whitelisted = func[](target: str.Str) : bool {
        let keys = public_routes.keys()
        for (let i = 0; i < keys.length; i += 1) {
            if ((public_routes[keys[i]] == "starts-with" && target.startswith(keys[i])) || (public_routes[keys[i]] == "full-match" && target == keys[i])) {
                return true
            }
        }
        return false
    }

    if (check_if_whitelisted(req.target.target) == false) {
        if (req.headers.headers.contains("cookie") == false) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("not authenticated: missing cookie header"))
        }
        let cookie = kiana.cookie.parse(req.headers.headers["cookie"])
        if (cookie == null || cookie.get("pardo_session") == null || cookie.get("pardo_session").trim() == "") {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("not authenticated: error parsing cookie header or missing pardo_session cookie"))
        }
        let [token, err] = jwt.extract_payload(jwt.parse(cookie.get("pardo_session")).unwrap(), jwt.HMACSHA256(pcontext.config.secret_key))
        if (err != null) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("not authenticated: invalid session payload"))
        }
        let jwtoken = types.PardoJWTClaims.from_json(token)
        let [user, err] = data_provider.get_user_by_id(jwtoken.user)
        if (err != null) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("invalid user"))
        }
        if (req.target.target.startswith("/v1/admin") && user.permission != types.Permission.Administrator) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("permission denied"))
        }
        return lang.Result<kiana.request.Request, kiana.response.Response>.ok(req)
    } else {
        return lang.Result<kiana.request.Request, kiana.response.Response>.ok(req)
    }
}

// /v1/admin/config/get
func route_admin_get_config(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [config, err] = data_provider.get_config()
    if (err != null) {
        return make_error_response("failed to fetch config")
    }

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok"))
            .put("data", json.JSONDict()
                .put("host", config.host)
                .put("port", json.Numeric(config.port))
                .put("artifacts_dir", config.artifacts_dir)
                .put("secret_key", config.secret_key) as json.JSONValue) as json.JSONValue
    )
}

// /v1/admin/config/set
func route_admin_set_config(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("host") == false || body.contains("port") == false || body.contains("artifacts_dir") == false || body.contains("secret_key") == false) {
        return make_error_response("invalid request: missing host, port, artifacts_dir or secret_key")
    }
    let host = dyn_cast<str.Str>(body["host"])
        , port = dyn_cast<json.Numeric>(body["port"])
        , artifacts_dir = dyn_cast<str.Str>(body["artifacts_dir"])
        , secret_key = dyn_cast<str.Str>(body["secret_key"])

    data_provider.update_config(host, port.getInt(), artifacts_dir, secret_key)
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/admin/user/add
func route_admin_add_user(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [body_json, err] = req.json()

    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("username") == false || body.contains("password") == false) {
        return make_error_response("invalid request: missing username or password")
    }
    let username = dyn_cast<str.Str>(body["username"])
    let password = dyn_cast<str.Str>(body["password"])
    let [user, err] = data_provider.get_user_by_username(username)
    if (err != null) {
        return make_error_response("user already exists")
    }
    if (data_provider.add_user(username, password) != dataProvider.ResultCode.Success) {
        return make_error_response("failed to add user")
    }
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/user/login
func route_login(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("username") == false || body.contains("password") == false) {
        return make_error_response("invalid request: missing username or password")
    }
    let username = dyn_cast<str.Str>(body["username"])
    let password = dyn_cast<str.Str>(body["password"])
    let [user_id, err] = data_provider.auth_user(username, password)
    if (err != null) {
        return make_error_response("invalid username or password")
    }

    let session = jwt.JWTBuilder(jwt.HMACSHA256(pcontext.config.secret_key))
        .set_claim(types.PardoJWTClaims(user_id, 0).to_json())
        .yield()

    let cookie = kiana.cookie.Cookie()
        .put("pardo_session", str.Stringable(session).to_string())
        .path("/")
        .http_only(true)
        .max_age(time.Duration.days(30))

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK")
            .set_cookie(str.Stringable(cookie).to_string()),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/user/logout
func route_logout(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let cookie = kiana.cookie.Cookie()
        .put("pardo_session", "")
        .path("/")
        .http_only(true)

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK")
            .set_cookie(str.Stringable(cookie).to_string()),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/user/info
func route_user_info(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [user_id, id_err] = get_current_user_id(req)
    if (id_err != null) {
        return make_error_response("not authenticated")
    }

    let [user, err] = data_provider.get_user_by_id(user_id)
    if (err != null) {
        return make_error_response("user not found")
    }

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok"))
            .put("id", json.Numeric(user.id))
            .put("username", user.username)
            .put("email", user.email)
            .put("description", user.description)
            .put("permission", json.Numeric(user.permission)) as json.JSONValue
    )
}

// /v1/package/list
func route_package_list(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [packages, err] = data_provider.get_package_list()
    if (err != null) {
        return make_error_response("failed to fetch packages")
    }

    let list = json.JSONList()
    for (let i = 0; i < packages.length; i += 1) {
        let pkg = packages[i]
        list.push(json.JSONDict()
            .put("id", json.Numeric(pkg.id))
            .put("name", pkg.name)
            .put("author", pkg.author)
            .put("description", pkg.description)
            .put("license", pkg.license)
            .put("readme", pkg.readme)
            .put("repository", pkg.repository) as json.JSONValue
        )
    }

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok"))
            .put("data", list) as json.JSONValue
    )
}

// /v1/package/info
func route_package_info(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("name") == false) {
        return make_error_response("invalid request: missing package name")
    }
    
    let name = dyn_cast<str.Str>(body["name"])
    let [pkg, pkg_err] = data_provider.get_package_by_name(name)
    if (pkg_err != null) {
        return make_error_response("package not found")
    }

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok"))
            .put("data", json.JSONDict()
                .put("id", json.Numeric(pkg.id))
                .put("name", pkg.name)
                .put("author", pkg.author)
                .put("description", pkg.description)
                .put("license", pkg.license)
                .put("readme", pkg.readme)
                .put("repository", pkg.repository)
            ) as json.JSONValue
    )
}

// /v1/package/add
func route_package_add(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [user_id, id_err] = get_current_user_id(req)
    if (id_err != null) {
        return make_error_response("not authenticated")
    }
    
    let [user, u_err] = data_provider.get_user_by_id(user_id)
    if (u_err != null) {
        return make_error_response("user not found")
    }

    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    
    if (body.contains("name") == false || body.contains("description") == false || body.contains("repository") == false || body.contains("license") == false || body.contains("readme") == false) {
        return make_error_response("invalid request: missing required fields")
    }

    let name = dyn_cast<str.Str>(body["name"])
    let description = dyn_cast<str.Str>(body["description"])
    let repository = dyn_cast<str.Str>(body["repository"])
    let license = dyn_cast<str.Str>(body["license"])
    let readme = dyn_cast<str.Str>(body["readme"])

    if (data_provider.register_package(name, user.username, description, repository, license, readme) != dataProvider.ResultCode.Success) {
        return make_error_response("failed to register package")
    }

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/package/update
func route_package_update(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [user_id, id_err] = get_current_user_id(req)
    if (id_err != null) {
        return make_error_response("not authenticated")
    }

    let [user, u_err] = data_provider.get_user_by_id(user_id)
    if (u_err != null) {
        return make_error_response("user not found")
    }

    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)

    if (body.contains("id") == false) {
        return make_error_response("invalid request: missing package id")
    }

    let pkg_id = dyn_cast<json.Numeric>(body["id"])
    let [pkg, pkg_err] = data_provider.get_package_by_id(pkg_id.getInt())
    if (pkg_err != null) {
        return make_error_response("package not found")
    }

    // Check ownership
    if (pkg.author != user.username && user.permission != types.Permission.Administrator) {
        return make_error_response("permission denied: not the author")
    }

    let name = pkg.name
    let description = pkg.description
    let repository = pkg.repository
    let license = pkg.license
    let readme = pkg.readme

    if (body.contains("name")) {
        name = dyn_cast<str.Str>(body["name"])
    }
    if (body.contains("description")) {
        description = dyn_cast<str.Str>(body["description"])
    }
    if (body.contains("repository")) {
        repository = dyn_cast<str.Str>(body["repository"])
    }
    if (body.contains("license")) {
        license = dyn_cast<str.Str>(body["license"])
    }
    if (body.contains("readme")) {
        readme = dyn_cast<str.Str>(body["readme"])
    }

    // Author remains the same unless explicit admin logic, here we keep original author
    let [success, update_err] = data_provider.update_package(pkg.id, name, pkg.author, description, repository, license, readme)
    if (update_err != null) {
        return make_error_response("failed to update package")
    }

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/package/remove
func route_package_remove(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [user_id, id_err] = get_current_user_id(req)
    if (id_err != null) {
        return make_error_response("not authenticated")
    }

    let [user, u_err] = data_provider.get_user_by_id(user_id)
    if (u_err != null) {
        return make_error_response("user not found")
    }

    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)

    if (body.contains("id") == false) {
        return make_error_response("invalid request: missing package id")
    }

    let pkg_id = dyn_cast<json.Numeric>(body["id"])
    let [pkg, pkg_err] = data_provider.get_package_by_id(pkg_id.getInt())
    if (pkg_err != null) {
        return make_error_response("package not found")
    }

    // Check ownership
    if (pkg.author != user.username && user.permission != types.Permission.Administrator) {
        return make_error_response("permission denied: not the author")
    }

    let [success, del_err] = data_provider.delete_package(pkg.id)
    if (del_err != null) {
        return make_error_response("failed to delete package")
    }

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/package/version/list
func route_package_version_list(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("package_id") == false) {
        return make_error_response("invalid request: missing package_id")
    }
    let pkg_id = dyn_cast<json.Numeric>(body["package_id"])
    let [versions, v_err] = data_provider.get_package_versions(pkg_id.getInt())
    if (v_err != null) {
        return make_error_response("failed to fetch versions")
    }
    let list = json.JSONList()
    for (let i = 0; i < versions.length; i += 1) {
        list.push(versions[i].to_json())
    }
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok"))
            .put("data", list) as json.JSONValue
    )
}

// /v1/package/version/info
func route_package_version_info(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("package_id") == false || body.contains("tag_name") == false) {
        return make_error_response("invalid request: missing package_id or tag_name")
    }
    let pkg_id = dyn_cast<json.Numeric>(body["package_id"])
    let tag_name = dyn_cast<str.Str>(body["tag_name"])
    let [version, v_err] = data_provider.get_package_version(pkg_id.getInt(), tag_name)
    if (v_err != null) {
        return make_error_response("version not found")
    }
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok"))
            .put("data", version.to_json()) as json.JSONValue
    )
}

// /v1/package/version/add
func route_package_version_add(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [user_id, id_err] = get_current_user_id(req)
    if (id_err != null) {
        return make_error_response("not authenticated")
    }
    let [user, u_err] = data_provider.get_user_by_id(user_id)
    if (u_err != null) {
        return make_error_response("user not found")
    }
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("package_id") == false || body.contains("tag_name") == false || body.contains("revision_notes") == false || body.contains("artifacts") == false) {
        return make_error_response("invalid request: missing required fields")
    }
    let pkg_id = dyn_cast<json.Numeric>(body["package_id"])
    let tag_name = dyn_cast<str.Str>(body["tag_name"])
    let revision_notes = dyn_cast<str.Str>(body["revision_notes"])
    let artifacts_json = dyn_cast<json.JSONList>(body["artifacts"])
    let artifacts = json.JSONValue(artifacts_json).to_string()

    let [pkg, pkg_err] = data_provider.get_package_by_id(pkg_id.getInt())
    if (pkg_err != null) {
        return make_error_response("package not found")
    }
    if (pkg.author != user.username && user.permission != types.Permission.Administrator) {
        return make_error_response("permission denied")
    }

    if (data_provider.add_package_version(pkg_id.getInt(), tag_name, revision_notes, artifacts) != dataProvider.ResultCode.Success) {
        return make_error_response("failed to add version")
    }
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/package/version/update
func route_package_version_update(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
    let [user_id, id_err] = get_current_user_id(req)
    if (id_err != null) {
        return make_error_response("not authenticated")
    }
    let [user, u_err] = data_provider.get_user_by_id(user_id)
    if (u_err != null) {
        return make_error_response("user not found")
    }
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("package_id") == false || body.contains("tag_name") == false || body.contains("revision_notes") == false || body.contains("artifacts") == false) {
        return make_error_response("invalid request: missing required fields")
    }
    let pkg_id = dyn_cast<json.Numeric>(body["package_id"])
    let tag_name = dyn_cast<str.Str>(body["tag_name"])
    let revision_notes = dyn_cast<str.Str>(body["revision_notes"])
    let artifacts_json = dyn_cast<json.JSONList>(body["artifacts"])
    let artifacts = json.JSONValue(artifacts_json).to_string()

    let [pkg, pkg_err] = data_provider.get_package_by_id(pkg_id.getInt())
    if (pkg_err != null) {
        return make_error_response("package not found")
    }
    if (pkg.author != user.username && user.permission != types.Permission.Administrator) {
        return make_error_response("permission denied")
    }

    if (data_provider.update_package_version(pkg_id.getInt(), tag_name, revision_notes, artifacts) != dataProvider.ResultCode.Success) {
        return make_error_response("failed to update version")
    }
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

func main() : int {
    data_provider = dataProvider.DataProvider("blob/database.db")
    pcontext = context.PardoServerContext()
    pcontext.logger.log("pardo-server started")
    pcontext.logger.log("checking database status")
    if (data_provider.check_if_initialized() == false) {
        pcontext.logger.warn("database not initialized, initializing...")
        if (data_provider.init() == false) {
            pcontext.logger.error("database initialization failed")
            return 1
        }
        pcontext.logger.log("database initialized")
    }
    let [config, err] = data_provider.get_config()
    if (err != null) {
        pcontext.logger.error("failed to get config")
        return 1
    }
    check_admin_status()
    
    pcontext.config = config
    pcontext.logger.log("config loaded")
    application = kiana.application.Application(
        kiana.application.ApplicationConfig(config.host, config.port)
    )
    application.logger = pcontext.logger
    application.use_before_request(func post_authentication)
    application.use_route("/", func route_root)
    application.use_route("/v1/admin/user/add", func route_admin_add_user)
    application.use_route("/v1/admin/config/update", func route_admin_set_config)
    application.use_route("/v1/admin/config/get", func route_admin_get_config)
    application.use_route("/v1/user/login", func route_login)
    application.use_route("/v1/user/logout", func route_logout)
    application.use_route("/v1/user/info", func route_user_info)
    application.use_route("/v1/package/list", func route_package_list)
    application.use_route("/v1/package/info", func route_package_info)
    application.use_route("/v1/package/add", func route_package_add)
    application.use_route("/v1/package/update", func route_package_update)
    application.use_route("/v1/package/remove", func route_package_remove)
    application.use_route("/v1/package/version/list", func route_package_version_list)
    application.use_route("/v1/package/version/info", func route_package_version_info)
    application.use_route("/v1/package/version/add", func route_package_version_add)
    application.use_route("/v1/package/version/update", func route_package_version_update)
    application.serve()

    return 0
}