    let [_, err] = data_provider.get_user_by_username("jerry_chou")
    if (err != null) {
        pcontext.logger.log("No admin user found, creating one...")
        if (data_provider.add_user("jerry_chou", "<placeholder>") != dataProvider.ResultCode.Success) {
            pcontext.logger.error("Failed to create admin user: unable to add user")
            pcontext.logger.error(data_provider.db.error_message())
            return
        }

        let [user, err] = data_provider.get_user_by_username("jerry_chou")
        if (err != null) {
            pcontext.logger.error("Failed to create admin user")
            return
        }
            
        data_provider.update_user_password(user.id, console.input("Enter admin password:").trim())

        data_provider.update_user(
            user.id,
            "May all the beauty be blessed.",
            "zhouyongkang4321@gmail.com",
            types.Permission.Administrator
        )
        pcontext.logger.log("Admin user created")
