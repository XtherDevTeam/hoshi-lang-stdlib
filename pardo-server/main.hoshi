use net "net"
use str "str"
use console "console"
use runtime "runtime"
use kiana "kiana"
use http "net/http"
use hashMap "hashMap"
use json "json"
use fs "fs"
use file "file"
use jwt "jwt"
use time "time"
use dataProvider "share/dataProvider"
use context "share/context"
use types "share/types"
use lang "builtin"

let pcontext : context.PardoServerContext = null
let application : kiana.application.Application = null
let data_provider : dataProvider.DataProvider = null
let public_routes = hashMap.HashMap<str.Str, str.Str>()
    .put("/", "full-match")
    .put("/index", "starts-with")
    .put("/v1/user/login", "full-match")

func check_admin_status() : none {
    let [_, err] = data_provider.get_user_by_username("jerry_chou")
    if (err != null) {
        pcontext.logger.log("No admin user found, creating one...")
        if (data_provider.add_user("jerry_chou", "<placeholder>") != dataProvider.ResultCode.Success) {
            pcontext.logger.error("Failed to create admin user: unable to add user")
            pcontext.logger.error(data_provider.db.error_message())
            return
        }

        let [user, err] = data_provider.get_user_by_username("jerry_chou")
        if (err != null) {
            pcontext.logger.error("Failed to create admin user")
            return
        }
            
        data_provider.update_user_password(user.id, console.input("Enter admin password:").trim())

        data_provider.update_user(
            user.id,
            "May all the beauty be blessed.",
            "zhouyongkang4321@gmail.com",
            types.Permission.Administrator
        )
        pcontext.logger.log("Admin user created")
    }
}

func make_error_response(message: str.Str) : kiana.response.Response {
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("error"))
            .put("message", message) as json.JSONValue
    )
}

// /
func route_root(req: kiana.request.Request) : kiana.response.Response {
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("server", str.Str("pardo-package-manager-remote-server"))
            .put("api", json.Numeric(1))
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

func post_authentication(req: kiana.request.Request) : lang.Result<kiana.request.Request, kiana.response.Response> {
    let check_if_whitelisted = func[](target: str.Str) : bool {
        let keys = public_routes.keys()
        for (let i = 0; i < keys.length; i += 1) {
            if ((public_routes[keys[i]] == "starts-with" && target.startswith(keys[i])) || (public_routes[keys[i]] == "full-match" && target == keys[i])) {
                return true
            }
        }
        return false
    }

    if (check_if_whitelisted(req.target.target) == false) {
        if (req.headers.headers.contains("cookie") == false) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("not authenticated: missing cookie header"))
        }
        let cookie = kiana.cookie.parse(req.headers.headers["cookie"])
        if (cookie == null || cookie.get("pardo_session") == null) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("not authenticated: error parsing cookie header or missing pardo_session cookie"))
        }
        let [token, err] = jwt.extract_payload(jwt.parse(cookie.get("pardo_session")).unwrap(), jwt.HMACSHA256(pcontext.config.secret_key))
        if (err != null) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("not authenticated: invalid session payload"))
        }
        let jwtoken = types.PardoJWTClaims.from_json(token)
        let [user, err] = data_provider.get_user_by_id(jwtoken.user)
        if (err != null) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("invalid user"))
        }
        if (req.target.target.startswith("/v1/admin") && user.permission != types.Permission.Administrator) {
            return lang.Result<kiana.request.Request, kiana.response.Response>.err(make_error_response("permission denied"))
        }
        return lang.Result<kiana.request.Request, kiana.response.Response>.ok(req)
    } else {
        return lang.Result<kiana.request.Request, kiana.response.Response>.ok(req)
    }
}

// /v1/admin/user/add
func route_admin_add_user(req: kiana.request.Request) : kiana.response.Response {
    let [body_json, err] = req.json()

    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("username") == false || body.contains("password") == false) {
        return make_error_response("invalid request: missing username or password")
    }
    let username = dyn_cast<str.Str>(body["username"])
    let password = dyn_cast<str.Str>(body["password"])
    let [user, err] = data_provider.get_user_by_username(username)
    if (err != null) {
        return make_error_response("user already exists")
    }
    if (data_provider.add_user(username, password) != dataProvider.ResultCode.Success) {
        return make_error_response("failed to add user")
    }
    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}

// /v1/user/login
func route_login(req: kiana.request.Request) : kiana.response.Response {
    let [body_json, err] = req.json()
    if (err != null) {
        return make_error_response("invalid request: error parsing json")
    }
    let body = dyn_cast<json.JSONDict>(body_json)
    if (body.contains("username") == false || body.contains("password") == false) {
        return make_error_response("invalid request: missing username or password")
    }
    let username = dyn_cast<str.Str>(body["username"])
    let password = dyn_cast<str.Str>(body["password"])
    let [user_id, err] = data_provider.auth_user(username, password)
    if (err != null) {
        return make_error_response("invalid username or password")
    }

    let session = jwt.JWTBuilder(jwt.HMACSHA256(pcontext.config.secret_key))
        .set_claim(types.PardoJWTClaims(user_id, 0).to_json())
        .yield()

    let cookie = kiana.cookie.Cookie()
        .put("pardo_session", str.Stringable(session).to_string())
        .path("/")
        .http_only(true)
        .max_age(time.Duration.days(30))

    return kiana.response.Response(
        http.HTTPResponseHeader("HTTP/1.1", 200, "OK")
            .set_cookie(str.Stringable(cookie).to_string()),
        json.JSONDict()
            .put("status", str.Str("ok")) as json.JSONValue
    )
}


func main() : int {
    data_provider = dataProvider.DataProvider("blob/database.db")
    pcontext = context.PardoServerContext()
    pcontext.logger.log("pardo-server started")
    pcontext.logger.log("checking database status")
    if (data_provider.check_if_initialized() == false) {
        pcontext.logger.warn("database not initialized, initializing...")
        if (data_provider.init() == false) {
            pcontext.logger.error("database initialization failed")
            return 1
        }
        pcontext.logger.log("database initialized")
    }
    let [config, err] = data_provider.get_config()
    if (err != null) {
        pcontext.logger.error("failed to get config")
        return 1
    }
    check_admin_status()
    
    pcontext.config = config
    pcontext.logger.log("config loaded")
    application = kiana.application.Application(
        kiana.application.ApplicationConfig(config.host, config.port)
    )
    application.logger = pcontext.logger
    application.use_before_request(func post_authentication)
    application.use_route("/", func route_root)
    application.use_route("/v1/admin/user/add", func route_admin_add_user)
    application.use_route("/v1/user/login", func route_login)
    application.serve()

    return 0
}