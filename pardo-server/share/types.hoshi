            .put("description", this.description)
            .put("email", this.email)
            .put("permission", json.Numeric(this.permission))
    }
}

struct Artifact {
    id: int,
    package_id: int,
    filename: str.Str,
    mime: str.Str,
    destination: str.Str,
    constructor(package_id: int, filename: str.Str, mime: str.Str, destination: str.Str),
    constructor(),
    set_id(id: int) : Artifact,
    set_package_id(package_id: int) : Artifact,
    set_filename(filename: str.Str) : Artifact,
    set_mime(mime: str.Str) : Artifact,
    set_destination(destination: str.Str) : Artifact,
    to_json(): json.JSONValue
}

impl Artifact {
    constructor(package_id: int, filename: str.Str, mime: str.Str, destination: str.Str) {
        this.package_id = package_id
        this.filename = filename
        this.mime = mime
        this.destination = destination
    },
    constructor() {
    },
    set_id(id: int) : Artifact {
        this.id = id
        return this
    },
    set_package_id(package_id: int) : Artifact {
        this.package_id = package_id
        return this
    },
    set_filename(filename: str.Str) : Artifact {
        this.filename = filename
        return this
    },
    set_mime(mime: str.Str) : Artifact {
        this.mime = mime
        return this
    },
    set_destination(destination: str.Str) : Artifact {
        this.destination = destination
        return this
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("package_id", json.Numeric(this.package_id))
            .put("filename", this.filename)
            .put("mime", this.mime)
            .put("destination", this.destination)
    }
}