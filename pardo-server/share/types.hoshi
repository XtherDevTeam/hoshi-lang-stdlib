struct Artifact {
    id: int,
    package_id: int,
    unique_id: str.Str,
    version: str.Str,
    filename: str.Str,
    mime: str.Str,
    destinations: str.Str,
    platform: str.Str,
    arch: str.Str,
    constructor(package_id: int, unique_id: str.Str, version: str.Str, filename: str.Str, mime: str.Str, destinations: str.Str, platform: str.Str, arch: str.Str),
    constructor(),
    set_id(id: int) : Artifact,
    set_package_id(package_id: int) : Artifact,
    set_unique_id(unique_id: str.Str) : Artifact,
    set_version(version: str.Str) : Artifact,
    set_filename(filename: str.Str) : Artifact,
    set_mime(mime: str.Str) : Artifact,
    set_destinations(destinations: str.Str) : Artifact,
    set_platform(platform: str.Str) : Artifact,
    set_arch(arch: str.Str) : Artifact,
    to_json(): json.JSONValue
}

impl Artifact {
    constructor(package_id: int, unique_id: str.Str, version: str.Str, filename: str.Str, mime: str.Str, destinations: str.Str, platform: str.Str, arch: str.Str) {
        this.package_id = package_id
        this.unique_id = unique_id
        this.version = version
        this.filename = filename
        this.mime = mime
        this.destinations = destinations
        this.platform = platform
        this.arch = arch
        this.id = 0
    },
    constructor() {
        return this
    },
    set_id(id: int) : Artifact {
        this.id = id
        return this
    },
    set_package_id(package_id: int) : Artifact {
        this.package_id = package_id
        return this
    },
    set_unique_id(unique_id: str.Str) : Artifact {
        this.unique_id = unique_id
        return this
    },
    set_version(version: str.Str) : Artifact {
        this.version = version
        return this
    },
    set_filename(filename: str.Str) : Artifact {
        this.filename = filename
        return this
    },
    set_mime(mime: str.Str) : Artifact {
        this.mime = mime
        return this
    },
    set_destinations(destinations: str.Str) : Artifact {
        this.destinations = destinations
        return this
    },
    set_platform(platform: str.Str) : Artifact {
        this.platform = platform
        return this
    },
    set_arch(arch: str.Str) : Artifact {
        this.arch = arch
        return this
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("package_id", json.Numeric(this.package_id))
            .put("unique_id", this.unique_id)
            .put("version", this.version)
            .put("filename", this.filename)
            .put("mime", this.mime)
            .put("destinations", this.destinations)
            .put("platform", this.platform)
            .put("arch", this.arch)
    }
}
