use str "str"
use vec "vec"
use json "json"

enum Permission {
    Administrator = 0,
    User = 1
}

struct Config {
    host: str.Str,
    port: int,
    artifacts_dir: str.Str,
    secret_key: str.Str,
    constructor(host: str.Str, port: int, artifacts_dir: str.Str, secret_key: str.Str),
    constructor(),
    set_host(host: str.Str) : Config,
    set_port(port: int) : Config,
    set_artifacts_dir(artifacts_dir: str.Str) : Config,
    set_secret_key(secret_key: str.Str) : Config
}

impl Config {
    constructor(host: str.Str, port: int, artifacts_dir: str.Str, secret_key: str.Str) {
        this.host = host
        this.port = port
        this.artifacts_dir = artifacts_dir
        this.secret_key = secret_key
    },
    constructor() {
        return this
    },
    set_secret_key(secret_key: str.Str) : Config {
        this.secret_key = secret_key
        return this
    },
    set_host(host: str.Str) : Config {
        this.host = host
        return this
    },
    set_port(port: int) : Config {
        this.port = port
        return this
    },
    set_artifacts_dir(artifacts_dir: str.Str) : Config {
        this.artifacts_dir = artifacts_dir
        return this
    }
}

struct PardoJWTClaims {
    user: int,
    exp: int,
    constructor(user: int, exp: int),
    constructor(),
    set_user(user: int) : PardoJWTClaims,
    set_exp(exp: int) : PardoJWTClaims,
    static from_json(v: json.JSONDict) : PardoJWTClaims,
    to_json(): json.JSONDict
}

impl PardoJWTClaims {
    constructor(user: int, exp: int) {
        this.user = user
        this.exp = exp
    },
    constructor() {
    },
    set_user(user: int) : PardoJWTClaims {
        this.user = user
        return this
    },
    set_exp(exp: int) : PardoJWTClaims {
        this.exp = exp
        return this
    },
    static from_json(v: json.JSONDict) : PardoJWTClaims {
        let user = dyn_cast<json.Numeric>(v["user"])
        let exp = dyn_cast<json.Numeric>(v["exp"])
        if (user == null || exp == null) {
            return null
        }
        return PardoJWTClaims(user.getInt(), exp.getInt())
    },
    to_json() : json.JSONDict {
        return json.JSONDict()
            .put("user", json.Numeric(this.user))
            .put("exp", json.Numeric(this.exp))
    }
}

struct User {
    id: int,
    username: str.Str,
    password_salted: str.Str,
    description: str.Str,
    email: str.Str,
    permission: int,
    constructor(username: str.Str, password_salted: str.Str, description: str.Str, email: str.Str, permission: int),
    constructor(),
    set_id(id: int) : User,
    set_username(username: str.Str) : User,
    set_password_salted(password_salted: str.Str) : User,
    set_description(description: str.Str) : User,
    set_email(email: str.Str) : User,
    set_permission(permission: int) : User,
    to_json(): json.JSONValue
}

struct PackageVersion {
    id: int,
    package_id: int,
    tag_name: str.Str,
    revision_notes: str.Str,
    artifacts: str.Str,
    dependencies: str.Str,
    created_at: str.Str,
    constructor(package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: str.Str, dependencies: str.Str),
    constructor(),
    set_id(id: int) : PackageVersion,
    set_package_id(package_id: int) : PackageVersion,
    set_tag_name(tag_name: str.Str) : PackageVersion,
    set_revision_notes(revision_notes: str.Str) : PackageVersion,
    set_artifacts(artifacts: str.Str) : PackageVersion,
    set_dependencies(dependencies: str.Str) : PackageVersion,
    set_created_at(created_at: str.Str) : PackageVersion,
    to_json(): json.JSONValue
}

impl PackageVersion {
    constructor(package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: str.Str, dependencies: str.Str) {
        this.package_id = package_id
        this.tag_name = tag_name
        this.revision_notes = revision_notes
        this.artifacts = artifacts
        this.dependencies = dependencies
        this.id = 0
        this.created_at = ""
    },
    constructor() {
        return this
    },
    set_id(id: int) : PackageVersion {
        this.id = id
        return this
    },
    set_package_id(package_id: int) : PackageVersion {
        this.package_id = package_id
        return this
    },
    set_tag_name(tag_name: str.Str) : PackageVersion {
        this.tag_name = tag_name
        return this
    },
    set_revision_notes(revision_notes: str.Str) : PackageVersion {
        this.revision_notes = revision_notes
        return this
    },
    set_artifacts(artifacts: str.Str) : PackageVersion {
        this.artifacts = artifacts
        return this
    },
    set_dependencies(dependencies: str.Str) : PackageVersion {
        this.dependencies = dependencies
        return this
    },
    set_created_at(created_at: str.Str) : PackageVersion {
        this.created_at = created_at
        return this
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("package_id", json.Numeric(this.package_id))
            .put("tag_name", this.tag_name)
            .put("revision_notes", this.revision_notes)
            .put("artifacts", json.parse(this.artifacts).unwrap())
            .put("dependencies", json.parse(this.dependencies).unwrap())
            .put("created_at", this.created_at)
    }
}


struct PackageInformation {
    id: int,
    name: str.Str,
    author: str.Str,
    description: str.Str,
    repository: str.Str,
    license: str.Str,
    readme: str.Str,
    constructor(name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str),
    constructor(),
    set_id(id: int) : PackageInformation,
    set_name(name: str.Str) : PackageInformation,
    set_author(author: str.Str) : PackageInformation,
    set_description(description: str.Str) : PackageInformation,
    set_repository(repository: str.Str) : PackageInformation,
    set_license(license: str.Str) : PackageInformation,
    set_readme(readme: str.Str) : PackageInformation,
    to_json(): json.JSONValue,
    static from_json(json: str.Str) : PackageInformation
}

impl PackageInformation {
    constructor(name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str) {
        this.name = name
        this.author = author
        this.description = description
        this.repository = repository
        this.license = license
        this.readme = readme
        this.id = 0
    },
    constructor() {
        return this
    },
    set_id(id: int) : PackageInformation {
        this.id = id
        return this
    },
    set_name(name: str.Str) : PackageInformation {
        this.name = name
        return this
    },
    set_author(author: str.Str) : PackageInformation {
        this.author = author
        return this
    },
    set_description(description: str.Str) : PackageInformation {
        this.description = description
        return this
    },
    set_repository(repository: str.Str) : PackageInformation {
        this.repository = repository
        return this
    },
    set_license(license: str.Str) : PackageInformation {
        this.license = license
        return this
    },
    set_readme(readme: str.Str) : PackageInformation {
        this.readme = readme
        return this
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("name", this.name)
            .put("author", this.author)
            .put("description", this.description)
            .put("repository", this.repository)
            .put("license", this.license)
            .put("readme", this.readme)
    }
}

