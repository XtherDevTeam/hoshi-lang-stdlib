use hashMap "hashMap"
use str "str"
use response "response"
use request "request"
use socket "net/socket"
use taskBackend "taskBackend"
use legacyBackend "backends/legacy"
use threadBackend "backends/thread"
use signal "signal"
use logger "logger"
use vec "vec"
use lang "builtin"
use route "route"

enum ResultCode {
    SUCCESS,
    SOCKET_CREATION_FAIL,
    SOCKET_BIND_FAIL,
    SOCKET_LISTEN_FAIL,
    HOSTNAME_RESOLUTION_FAIL,
}

alias BeforeRequestHook = func(request.Request) : lang.Result<request.Request, response.Response>
alias AfterRequestHook = func(response.Response) : lang.Result<response.Response, response.Response>

struct ApplicationConfig {
    host: str.Str,
    port: short,
    route: route.RouteTree,
    before_requests: vec.Vec<BeforeRequestHook>,
    after_requests: vec.Vec<AfterRequestHook>,
    error_endpoints: hashMap.HashMap<int, func() : response.Response>,
    constructor(host: str.Str, port: short),
    add_route(path: str.Str, handler: route.RouteHandler) : ApplicationConfig,
    add_error_endpoint(code: int, handler: func() : response.Response) : ApplicationConfig,
    add_before_request(hook: BeforeRequestHook) : ApplicationConfig,
    add_after_request(hook: AfterRequestHook) : ApplicationConfig
}

impl ApplicationConfig {
    constructor(host: str.Str, port: short) {
        this.host = host
        this.port = port
        this.route = route.RouteTree()
        this.before_requests = vec.Vec<BeforeRequestHook>()
        this.after_requests = vec.Vec<AfterRequestHook>()
        this.error_endpoints = hashMap.HashMap<int, func() : response.Response>()
    },
    add_route(path: str.Str, handler: route.RouteHandler) : ApplicationConfig {
        this.route.insert(path, handler)
        return this
    },
    add_error_endpoint(code: int, handler: func() : response.Response) : ApplicationConfig {
        this.error_endpoints[code] = handler
        return this
    },
    add_before_request(hook: BeforeRequestHook) : ApplicationConfig {
        this.before_requests.push(hook)
        return this
    },
    add_after_request(hook: AfterRequestHook) : ApplicationConfig {
        this.after_requests.push(hook)
        return this
    }
}

struct Application {
    config: ApplicationConfig,
    socket: socket.Socket,
    backend: taskBackend.TaskBackend,
    logger: logger.Logger,
    serve() : ResultCode,
    use_route(path: str.Str, handler: route.RouteHandler) : none,
    use_before_request(hook: BeforeRequestHook) : none,
    use_after_request(hook: AfterRequestHook) : none,
    use_error_endpoint(code: int, handler: func() : response.Response) : none,
    constructor(config: ApplicationConfig),
    constructor(config: ApplicationConfig, backend: taskBackend.TaskBackend),
    constructor(config: ApplicationConfig, backend: taskBackend.TaskBackend, logger: logger.Logger),
    static handler(app: Application, client: socket.Socket) : response.Response,
    static dispatch_error_endpoint(app: Application, code: int, message: str.Str, endpoint: str.Str) : response.Response
}

impl Application {
    constructor(config: ApplicationConfig) {
        this.config = config
        this.backend = threadBackend.ThreadingBackend()
        this.logger = logger.ConsoleLogger(logger.Severity.INFO)
    },
    constructor(config: ApplicationConfig, backend: taskBackend.TaskBackend) {
        this.config = config
        this.backend = backend
        this.logger = logger.ConsoleLogger(logger.Severity.INFO)
    },
    constructor(config: ApplicationConfig, backend: taskBackend.TaskBackend, logger: logger.Logger) {
        this.config = config
        this.backend = backend
        this.logger = logger
    },
    use_before_request(hook: BeforeRequestHook) : none {
        this.config.add_before_request(hook)
    },
    use_after_request(hook: AfterRequestHook) : none {
        this.config.add_after_request(hook)
    },
    use_error_endpoint(code: int, handler: func() : response.Response) : none {
        this.config.add_error_endpoint(code, handler)
    },
    use_route(path: str.Str, handler: route.RouteHandler) : none {
        this.config.add_route(path, handler)
    },
    serve() : ResultCode {
        let sock = socket.socket()
        if (sock.is_err()) {
            return ResultCode.SOCKET_CREATION_FAIL
        }
        this.logger.debug("Socket created")

        signal.init()
        let sig_handler = func[this] (signum: int) : none {
            this.this.socket.close()
        }
        signal.register(signal.Signal.SIGINT, sig_handler)
        this.logger.debug("Signal handler registered")

        this.socket = sock.unwrap()
        let resolved_host = socket.resolve_name(this.config.host)
        if (resolved_host.is_err()) {
            return ResultCode.HOSTNAME_RESOLUTION_FAIL
        }
        if (this.socket.bind(resolved_host.unwrap(), this.config.port) != socket.ResultCode.SUCCESS) {
            return ResultCode.SOCKET_BIND_FAIL
        }
        this.logger.debug(str.format("Socket bound at {}:{}", this.config.host, this.config.port as int))
        if (this.socket.listen(32) != socket.ResultCode.SUCCESS) {
            return ResultCode.SOCKET_LISTEN_FAIL
        }
        this.logger.debug("Socket listening")
        this.logger.info(str.format("Server started at {}:{}", this.config.host, this.config.port as int))

        while (true) {
            let client = this.socket.accept()
            if (client.is_err()) {
                break
            }
            this.logger.debug("Client connected")
            this.backend.new_task(client.unwrap() as socket.AbstractSocket, func[this, client] () : response.Response {
                return Application.handler(this.this, this.client.unwrap())
            })
        }

        this.logger.info("Server stopped, probably by signal")

        signal.default(signal.Signal.SIGINT)

        return ResultCode.SUCCESS
    },
    static handler(app: Application, client: socket.Socket) : response.Response {
        let req = request.request(client)

        let wrap_after_request = func [req, app] (resp: response.Response) : response.Response {
            for (let index = this.app.config.after_requests.length - 1; index >= 0; index -= 1) {
                let hook_result = this.app.config.after_requests[index](resp)
                if (hook_result.is_err()) {
                    return hook_result.unwrap_err()
                }
                resp = hook_result.unwrap()
            }
            return resp
        }

        if (req.is_err()) {
            return wrap_after_request(Application.dispatch_error_endpoint(app, 400, "Bad Request", "unknown"))
        }

        for (let index = 0; index < app.config.before_requests.length; index += 1) {
            let hook_result = app.config.before_requests[index](req.unwrap())
            if (hook_result.is_err()) {
                return hook_result.unwrap_err()
            }
            req.value = hook_result.unwrap()
        }

        let match_result = app.config.route.match(req.unwrap().target.target)
        if (match_result.is_err()) {
            return wrap_after_request(Application.dispatch_error_endpoint(app, 404, "Not Found", req.unwrap().target.target))
        }

        app.logger.info(str.format("Serving request for endpoint {}", req.unwrap().target.target))
        
        let [handler, params] = match_result.unwrap()
        let resp = handler(req.unwrap(), params)

        return wrap_after_request(resp)
    },
    static dispatch_error_endpoint(app: Application, code: int, message: str.Str, endpoint: str.Str) : response.Response {
        if (app.config.error_endpoints.contains(code) == false) {
            let resp = response.Response(code, message, str.format("
                <html>
                <head>
                <title>{} {}</title>
                </head>
                <body>
                <h1>{} {}</h1>
                <p>An error occurred when processing your request</p>
                <p>Server: hoshi-std-kiana</p>
                <p>Endpoint: {}</p>
                </body>
                </html>
                ", code, message, code, message, endpoint))
            resp.headers.add_header("Content-Type", "text/html; charset=utf-8")
            return resp
        }

        app.logger.error(str.format("Serving {} request for endpoint {}", code, endpoint))
        let handle = app.config.error_endpoints[code]
        return handle()
    }
}