use str "str"
use hashMap "hashMap"
use time "time"

struct Cookie {
    sections: hashMap.HashMap<str.Str, str.Str>,
    section_secure: bool,
    section_http_only: bool,
    constructor(),
    constructor(sections: hashMap.HashMap<str.Str, str.Str>),
    put(key: str.Str, value: str.Str) : Cookie,
    get(key: str.Str) : str.Str,
    remove(key: str.Str) : Cookie,
    contains(key: str.Str) : bool,
    expires(date: time.Date) : Cookie,
    max_age(duration: time.Duration) : Cookie,
    secure(set: bool) : Cookie,
    http_only(set: bool) : Cookie,
    path(path: str.Str) : Cookie,
    to_string() : str.Str
}

impl Cookie {
    constructor() {
        this.sections = hashMap.HashMap<str.Str, str.Str>()
        this.section_secure = false
        this.section_http_only = false
    },
    constructor(sections: hashMap.HashMap<str.Str, str.Str>) {
        this.sections = sections
        this.section_secure = false
        this.section_http_only = false
    },
    put(key: str.Str, value: str.Str) : Cookie {
        this.sections.put(key, value)
        return this
    },
    get(key: str.Str) : str.Str {
        return this.sections[key]
    },
    remove(key: str.Str) : Cookie {
        this.sections.remove(key)
        return this
    },
    contains(key: str.Str) : bool {
        return this.sections.contains(key)
    },
    expires(date: time.Date) : Cookie {
        // in C strftime format "%a, %d %b %Y %H:%M:%S %Z"
        return this.put("expires", date.format("%a, %d %b %Y %H:%M:%S %Z"))
    },
    max_age(duration: time.Duration) : Cookie {
        return this.put("max-age", str.Stringable(duration.time.seconds).to_string())
    },
    secure(set: bool) : Cookie {
        this.section_secure = set
        return this
    },
    http_only(set: bool) : Cookie {
        this.section_http_only = set
        return this
    },
    path(path: str.Str) : Cookie {
        return this.put("path", path)
    },
    to_string() : str.Str {
        let result : str.Str = ""
        let keys = this.sections.keys()
        for (let i = 0; i < keys.length; i += 1) {
            let key = keys[i]
            let value = this.sections[key]
            result += key
            result.push('=')
            result += value
            result.push(';')
        }
        if (this.section_secure) {
            result += "secure;"
        }
        if (this.section_http_only) {
            result += "httponly;"
        }
        result.pop() // remove the last semicolon
        return result
    }
}

impl Cookie : str.Stringable {
    to_string() : str.Str {
        return this.to_string()
    }
}

/**
  * Parses a cookie string into a Cookie object.
  * @param {str.Str} cookie_str - The cookie string to parse.
  * @returns {Cookie} The parsed Cookie object.
  * @note No validation is performed on the cookie string.
  */
func parse(cookie_str: str.Str) : Cookie {
    let cookie = Cookie()
    let sections = cookie_str.split(";")
    for (let i = 0; i < sections.length; i += 1) {
        let section = sections[i]
        let key_value = section.split("=")
        if (key_value.length == 2) {
            let key = key_value[0].trim().lowercase()
            let value = key_value[1].trim()
            cookie.put(key, value)
        } elif (key_value.length == 1) {
            let key = key_value[0].trim().lowercase()
            if (key == "secure") {
                cookie.secure(true)
            } elif (key == "httponly") {
                cookie.http_only(true)
            }
        }
    }
    return cookie
}