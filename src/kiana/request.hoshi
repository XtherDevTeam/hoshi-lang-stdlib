use str "str"
use hashMap "hashMap"
use socket "net/socket"
use http "net/http"
use io "io"
use lang "builtin"
use json "json"
use math "math"
use runtime "runtime"
use random "random"
use fs "fs"
use file "file"

enum ResultCode {
    INVALID_HTTP_HEADER,
    BAD_RESPONSE,
    INVALID_CONTENT,
    MISMATCH_CONTENT_TYPE,
}

struct ResourceTarget {
    target: str.Str,
    queries: hashMap.HashMap<str.Str, str.Str>,
    fragment: str.Str,
    constructor(target: str.Str, queries: hashMap.HashMap<str.Str, str.Str>, fragment: str.Str),
    constructor(target: str.Str)
}

impl ResourceTarget {
    constructor(target: str.Str, queries: hashMap.HashMap<str.Str, str.Str>, fragment: str.Str) {
        this.target = target
        this.queries = queries
        this.fragment = fragment
    },
    constructor(target: str.Str) {
        this.queries = hashMap.HashMap<str.Str, str.Str>()
        let split = target.split("#")
        if (split.length > 1) {
            this.fragment = split[1]
        }
        split = split[0].split("?")
        this.target = split[0]
        if (split.length > 1) {
            let queries = split[1].split("&")
            for (let index = 0;index < queries.length;index += 1) {
                let query = queries[index].split("=")
                if (query.length > 1) {
                    this.queries[query[0]] = query[1]
                }
            }
        }
        return this
    }
}

struct FormDataReader {
    headers: hashMap.HashMap<str.Str, str.Str>,
    path: fs.Path,
    temp_file: fs.OSFile,
    constructor(headers: hashMap.HashMap<str.Str, str.Str>, path: fs.Path, temp_file: fs.OSFile),
    read(size: int) : file.ReadBufferView,
    write(data: char[]) : int,
    write(data: char[], start: int, size: int) : int,
    write(data: char[], size: int) : int,
    close() : none,
    seek(offset: int, whence: int) : int,
    tell() : int,
    flush() : none,
    is_eof() : bool,
    size() : int,
    is_seekable() : bool,
    is_readable() : bool,
    is_writable() : bool,
    is_closed() : bool,
    getch() : char,
    putch(c: char) : none,
    static create_temp_file(headers: hashMap.HashMap<str.Str, str.Str>) : FormDataReader,
    finalizer(),
    save_as(path: str.Str) : none,
}

impl FormDataReader {
    static create_temp_file(headers: hashMap.HashMap<str.Str, str.Str>) : FormDataReader {
        let formDataName = "kiana-form" + str.Stringable(runtime.runtime_random_legacy_unsigned()).to_string()
        let path = fs.Path.temp_dir() / formDataName
        formDataName = str.Stringable(path).to_string()
        let [f, err] = fs.open(formDataName, "wb+")
        if (err != null) {
            return null
        }
        return FormDataReader(headers, path, f)
    },
    constructor(headers: hashMap.HashMap<str.Str, str.Str>, path: fs.Path, temp_file: fs.OSFile) {
        this.headers = headers
        this.path = path
        this.temp_file = temp_file
    },
    read(size: int) : file.ReadBufferView {
        return this.temp_file.read(size)
    },
    write(data: char[]) : int {
        return this.temp_file.write(data)
    },
    write(data: char[], start: int, size: int) : int {
        return this.temp_file.write(data, start, size)
    },
    write(data: char[], size: int) : int {
        return this.temp_file.write(data, size)
    },
    close() : none {
        this.temp_file.close()
    },
    seek(offset: int, whence: int) : int {
        return this.temp_file.seek(offset, whence)
    },
    tell() : int {
        return this.temp_file.tell()
    },
    flush() : none {
        this.temp_file.flush()
    },
    is_eof() : bool {
        return this.temp_file.is_eof()
    },
    size() : int {
        return this.temp_file.size()
    },
    is_seekable() : bool {
        return this.temp_file.is_seekable()
    },
    is_readable() : bool {
        return this.temp_file.is_readable()
    },
    is_writable() : bool {
        return this.temp_file.is_writable()
    },
    is_closed() : bool {
        return this.temp_file.is_closed()
    },
    getch() : char {
        return this.temp_file.getch()
    },
    putch(c: char) : none {
        this.temp_file.putch(c)
    },
    finalizer() {
        this.close()
        this.path.remove()
    },
    save_as(path: str.Str) : none {
        this.path.move(path)
    }
}

impl FormDataReader : file.AbstractFile {
    read(size: int) : file.ReadBufferView {
        return this.read(size)
    },
    write(data: char[]) : int {
        return this.write(data)
    },
    write(data: char[], start: int, size: int) : int {
        return this.write(data, start, size)
    },
    write(data: char[], size: int) : int {
        return this.write(data, size)
    },
    close() : none {
        this.close()
    },
    seek(offset: int, whence: int) : int {
        return this.seek(offset, whence)
    },
    tell() : int {
        return this.tell()
    },
    flush() : none {
        this.flush()
    },
    is_eof() : bool {
        return this.is_eof()
    },
    size() : int {
        return this.size()
    },
    is_seekable() : bool {
        return this.is_seekable()
    },
    is_readable() : bool {
        return this.is_readable()
    },
    is_writable() : bool {
        return this.is_writable()
    },
    is_closed() : bool {
        return this.is_closed()
    },
    getch() : char {
        return this.getch()
    },
    putch(c: char) : none {
        this.putch(c)
    }
}

func compute_kmp_lps(pattern: str.Str) : int[] {
    let m = pattern.length
    let lps = new int[m]() // Create integer array of size m
    let len = 0
    let i = 1
    lps[0] = 0
        
    while (i < m) {
        if (pattern.data[i] == pattern.data[len]) {
            len += 1
            lps[i] = len
            i += 1
        } else {
            if (len != 0) {
                len = lps[len - 1]
            } else {
                lps[i] = 0
                i += 1
            }
        }
    }
    return lps
}

func search_kmp(buffer: io.ArrayBuffer, start_offset: int, data_len: int, pattern: str.Str, lps: int[]) : int {
    let m = pattern.length
    let n = data_len
    let i = start_offset // index for buffer
    let j = 0 // index for pattern
        
    while (i < n) {
        if (pattern.data[j] == buffer.buf[i]) {
            j += 1
            i += 1
        }
        if (j == m) {
            return i - j // Match found at this index
            // j = lps[j - 1] // If we wanted to find next occurrences
        } elif (i < n && pattern.data[j] != buffer.buf[i]) {
            if (j != 0) {
                j = lps[j - 1]
            } else {
                i += 1
            }
        }
    }
    return -1
}


struct Request {
    headers: http.HTTPRequestHeader,
    target: ResourceTarget,
    socket: socket.AbstractSocket,
    cached_recv: io.ArrayBuffer,
    constructor(headers: http.HTTPRequestHeader, socket: socket.AbstractSocket),
    constructor(socket: socket.AbstractSocket),
    getch() : char,
    recv_next_raw_content() : lang.Result<io.ArrayBuffer, http.HTTPNetworkError>,
    recv_header() : lang.Result<Request, ResultCode>,
    iterate_chunk() : io.ArrayBuffer,
    json() : lang.Result<json.JSONValue, ResultCode>,
    text() : lang.Result<str.Str, ResultCode>,
    form_data(receiver : func(str.Str, FormDataReader) : none) : none,
    reader() : http.RequestReader
}

impl Request {
    constructor(headers: http.HTTPRequestHeader, socket: socket.AbstractSocket) {
        this.headers = headers
        this.socket = socket
        this.target = ResourceTarget(headers.target)
        this.cached_recv = io.ArrayBuffer(0)
    },
    reader() : http.RequestReader {
        return http.RequestReader(this.socket, this.cached_recv, this.headers.headers)
    },
    recv_next_raw_content() : lang.Result<io.ArrayBuffer, http.HTTPNetworkError> {
        let resp = this.socket.recv(65536u)
        if (resp.is_err()) {
            return lang.Result<io.ArrayBuffer, http.HTTPNetworkError>.err(http.HTTPNetworkError.CONNECTION_RESET)
        }
        let buf = resp.unwrap()
        if (buf.size == 0) {
            return lang.Result<io.ArrayBuffer, http.HTTPNetworkError>.err(http.HTTPNetworkError.CONNECTION_RESET)
        }
        this.cached_recv = buf
        return lang.Result<io.ArrayBuffer, http.HTTPNetworkError>.ok(buf)
    },
    iterate_chunk() : io.ArrayBuffer {
        if (this.headers.headers.contains("transfer-encoding") == false || this.headers.headers["transfer-encoding"] != "chunked") {
            return null
        }
        let chunk_size = 0
        let current_ch = this.getch()
        while ((current_ch >= '0' && current_ch <= '9') || (current_ch >= 'a' && current_ch <= 'f') || (current_ch >= 'A' && current_ch <= 'F')) {
            chunk_size = chunk_size * 16 + math.hextoint(current_ch)
            current_ch = this.getch()
        }
        if (current_ch != '\r' || this.getch() != '\n') {
            return null
        }
        let chunk_data = io.ArrayBuffer(chunk_size)
        let current_pos = 0

        let bytes_to_copy_from_cache = math.min(chunk_size, this.cached_recv.size - this.cached_recv.current_pos)

        if (bytes_to_copy_from_cache > 0) {
            runtime.memcpy(runtime.runtime_get_string_array_data_pointer(chunk_data.buf), runtime.runtime_get_string_array_data_pointer(this.cached_recv.buf) + this.cached_recv.current_pos, bytes_to_copy_from_cache)
        }

        current_pos = bytes_to_copy_from_cache
        this.cached_recv.current_pos += bytes_to_copy_from_cache

        while (current_pos < chunk_size) {
            let result = this.recv_next_raw_content()
            if (result.is_err()) {
                return null
            }
            let buf = result.unwrap()
            if (buf.size == 0) {
                return null
            }
            // if current_pos + buf.size is larger than chunk_size, we need to move its position to the end_pos and break
            let actual_read = math.min(chunk_size - current_pos, buf.size)
            runtime.memcpy(runtime.runtime_get_string_array_data_pointer(chunk_data.buf) + current_pos, runtime.runtime_get_string_array_data_pointer(buf.buf), actual_read)
            current_pos += actual_read
            if (actual_read < buf.size) {
                this.cached_recv.current_pos = actual_read
            }
        }
        // all data received, return
        if (this.getch() != '\r' || this.getch() != '\n') {
            return null
        }
        return chunk_data
    },
    text() : lang.Result<str.Str, http.HTTPNetworkError> {
        // check if chunked encoding is used
        if (this.headers.headers.contains("transfer-encoding") != false && this.headers.headers["transfer-encoding"] == "chunked") {
            let final = str.Str(65536u)
            while (true) {
                let chunk = this.iterate_chunk()
                if (chunk == null) {
                    return lang.Result<str.Str, http.HTTPNetworkError>.err(http.HTTPNetworkError.CONNECTION_RESET)
                }
                if (chunk.size == 0) {
                    break
                }
                final += chunk.buf
            }
            return lang.Result<str.Str, http.HTTPNetworkError>.ok(final)
        } elif (this.headers.headers.contains("content-length") != false) {
            let content_length = str.toInt(this.headers.headers["content-length"])
            if (content_length == 0) {
                return lang.Result<str.Str, http.HTTPNetworkError>.ok("")
            }
            let content = str.Str(content_length as unsigned)
            let current_pos = 0
            // if content length is larger than the remaining data, we need to read more data from the socket, but before that, we read the remaining data into the content buffer
            runtime.memcpy(runtime.runtime_get_string_array_data_pointer(content.data), runtime.runtime_get_string_array_data_pointer(this.cached_recv.buf) + this.cached_recv.current_pos, this.cached_recv.size - this.cached_recv.current_pos)
            current_pos = this.cached_recv.size - this.cached_recv.current_pos
            while (current_pos < content_length) {
                let result = this.recv_next_raw_content()
                if (result.is_err()) {
                    return lang.Result<str.Str, http.HTTPNetworkError>.err(result.unwrap_err())
                }
                let buf = result.unwrap()
                if (buf.size == 0) {
                    return lang.Result<str.Str, http.HTTPNetworkError>.err(http.HTTPNetworkError.CONNECTION_RESET)
                }
                let actual_read = math.min((content_length - current_pos) as unsigned, buf.size as unsigned)
                runtime.memcpy(runtime.runtime_get_string_array_data_pointer(content.data) + current_pos, runtime.runtime_get_string_array_data_pointer(buf.buf), actual_read)
                current_pos += actual_read
                if (actual_read < buf.size) {
                    this.cached_recv.current_pos = actual_read
                    break
                }
            }
            content.length = content_length
            return lang.Result<str.Str, http.HTTPNetworkError>.ok(content)
        } else {
            let content = str.Str(65536u)
            // if chunk size is larger than the remaining data, we need to read more data from the socket, but before that, we read the remaining data into the chunk buffer
            runtime.memcpy(runtime.runtime_get_string_array_data_pointer(content.data), runtime.runtime_get_string_array_data_pointer(this.cached_recv.buf) + this.cached_recv.current_pos, this.cached_recv.size - this.cached_recv.current_pos)
            content.length = this.cached_recv.size - this.cached_recv.current_pos
            while (true) {
                let result = this.recv_next_raw_content()
                if (result.is_err()) {
                    return lang.Result<str.Str, http.HTTPNetworkError>.err(result.unwrap_err())
                }
                let buf = result.unwrap()
                if (buf.size == 0) {
                    return lang.Result<str.Str, http.HTTPNetworkError>.err(http.HTTPNetworkError.CONNECTION_RESET)
                }
                content += buf.buf
                if (buf.size < 1024) {
                    break
                }
            }
            return lang.Result<str.Str, http.HTTPNetworkError>.ok(content)
        }
    },
    form_data(receiver : func(str.Str, FormDataReader) : none) : none {
        if (this.headers.headers.contains("content-type") == false || this.headers.headers["content-type"].startswith("multipart/form-data") == false) {
            return
        }
        
        // 1. Setup Constants
        let CHUNK_SIZE = 1048576 // 1MB
        let content_type = this.headers.headers["content-type"]
        let boundary_index = content_type.find("boundary=")
        let raw_boundary = content_type.substring(boundary_index + 9, content_type.length)
        
        // The delimiter inside the body is "\r\n--" + boundary
        // Note: The very first line is just "--" + boundary, handled separately
        let delimiter_str = "\r\n--" + raw_boundary
        let delimiter_lps = compute_kmp_lps(delimiter_str)
        let delimiter_len = delimiter_str.length
        
        let reader = this.reader()
        let buffer = io.ArrayBuffer(CHUNK_SIZE) 
        let buffer_valid_len = 0
        let buffer_pos = 0 // cursor position in current buffer

        // Helper to refill buffer if empty or move cursor
        // Returns false if EOF
        let ensure_data = func[buffer_pos, buffer_valid_len](reader: http.RequestReader, buffer: io.ArrayBuffer, CHUNK_SIZE: int) : bool {
            if (this.buffer_pos >= this.buffer_valid_len) {
                this.buffer_pos := 0
                let view = reader.read(CHUNK_SIZE)
                if (view.size == 0) { return false }
                
                // Copy read data into our managed buffer
                runtime.memcpy(runtime.runtime_get_string_array_data_pointer(buffer.buf), runtime.runtime_get_string_array_data_pointer(view.data), view.size)
                this.buffer_valid_len := view.size
                return true
            }
            return true
        }

        // Helper to read a line from our managed buffer
        let read_line_buffered = func[buffer_pos, buffer_valid_len, ensure_data](reader: http.RequestReader, buffer: io.ArrayBuffer, CHUNK_SIZE: int) : str.Str {
            let line = str.Str()
            while (true) {
                if (this.buffer_pos >= this.buffer_valid_len) {
                    if (this.ensure_data(reader, buffer, CHUNK_SIZE) == false) { break }
                }
                
                let ch = buffer.buf[this.buffer_pos]
                this.buffer_pos := this.buffer_pos + 1
                
                if (ch == '\n') {
                    break
                } elif (ch != '\r') {
                    line.push(ch)
                }
            }
            return line
        }

        // --- STEP 1: Skip Preamble ---
        // We look for "--" + boundary strictly.
        let first_boundary = "--" + raw_boundary
        while (true) {
            let line = read_line_buffered(reader, buffer, CHUNK_SIZE)
            if (line.trim() == first_boundary) {
                break
            }
            // If we hit EOF without finding boundary, just return
            if (buffer_pos >= buffer_valid_len && reader.is_eof()) { return }
        }

        // --- STEP 2: Process Parts Loop ---
        while (true) {
            // A. Parse Headers
            let part_headers = hashMap.HashMap<str.Str, str.Str>()
            while (true) {
                let line = read_line_buffered(reader, buffer, CHUNK_SIZE)
                if (line.length == 0) { break } // Empty line = End of headers
                
                let colon = line.find(":")
                if (colon != -1) {
                    part_headers[line.substring(0, colon).lowercase().trim()] = line.substring(colon + 1, line.length).trim()
                }
            }
            
            // Check if we reached end stream (often happens if prev part ended with --boundary--)
            if (part_headers.size() == 0 && reader.is_eof()) { break }

            let name : str.Str = "unknown"
            if (part_headers.contains("content-disposition")) {
                let cd = part_headers["content-disposition"]
                let name_index = cd.find("name=\"")
                if (name_index != -1) {
                    let name_end = cd.find("\"", name_index + 6)
                    if (name_end != -1) {
                        name = cd.substring(name_index + 6, name_end)
                    }
                }
            }

            // B. Stream Body Content with KMP
            let part_content = FormDataReader.create_temp_file(part_headers)
            
            while (true) {
                // 1. Ensure we have data
                if (buffer_pos >= buffer_valid_len) {
                    if (ensure_data(reader, buffer, CHUNK_SIZE) == false) { break }
                }

                // 2. Calculate Search Range
                // We search from buffer_pos to buffer_valid_len
                let available_len = buffer_valid_len - buffer_pos
                
                // 3. Run KMP Search
                let match_idx = search_kmp(buffer, buffer_pos, buffer_valid_len, delimiter_str, delimiter_lps)
                
                if (match_idx != -1) {
                    // --- MATCH FOUND ---
                    // Write data up to the match
                    let size_to_write = match_idx - buffer_pos
                    if (size_to_write > 0) {
                        part_content.write(buffer.buf, buffer_pos, size_to_write)
                    }
                    
                    // Move cursor past the delimiter to start of next headers/end
                    buffer_pos := match_idx + delimiter_len
                    break // Exit content loop, go to next part
                } else {
                    // --- NO MATCH FOUND ---
                    // We cannot write the whole buffer because the boundary might be split 
                    // between the end of this chunk and the start of the next.
                    // We must reserve (delimiter_len - 1) bytes.
                    
                    let reserve = delimiter_len - 1
                    let writeable_len = available_len - reserve
                    
                    if (writeable_len > 0) {
                        // Write safe part
                        part_content.write(buffer.buf, buffer_pos, writeable_len)
                        buffer_pos += writeable_len
                    }
                    
                    // Now we must move the 'reserve' bytes to the start of the buffer
                    // and refill the rest of the buffer to continue searching.
                    
                    let tail_len = buffer_valid_len - buffer_pos
                    // Move tail to index 0
                    if (tail_len > 0) {
                        runtime.memcpy(
                            runtime.runtime_get_string_array_data_pointer(buffer.buf), 
                            runtime.runtime_get_string_array_data_pointer(buffer.buf) + buffer_pos, 
                            tail_len
                        )
                    }
                    
                    // Read new chunk to fill the rest
                    let read_req_size = CHUNK_SIZE - tail_len
                    let view = reader.read(read_req_size)
                    
                    if (view.size == 0) {
                        // EOF unexpected inside a part? write remaining and break
                        part_content.write(buffer.buf, tail_len)
                        break
                    }
                    
                    // Append new data after tail
                    runtime.memcpy(
                        runtime.runtime_get_string_array_data_pointer(buffer.buf) + tail_len,
                        runtime.runtime_get_string_array_data_pointer(view.data),
                        view.size
                    )
                    
                    buffer_pos := 0
                    buffer_valid_len = tail_len + view.size
                }
            }
            
            // C. Finalize Part
            part_content.seek(0, 0) // Reset file pointer for user
            receiver(name, part_content)
            
            // D. Check for End of Stream (--boundary--)
            // At this point, buffer_pos is right after \r\n--boundary
            // We need to check next 2 chars.
            
            // Ensure we have at least 2 bytes in buffer
            if (buffer_valid_len - buffer_pos < 2) {
                // Shift remaining to 0 and read more
                let tail = buffer_valid_len - buffer_pos
                if (tail > 0) {
                    runtime.memcpy(runtime.runtime_get_string_array_data_pointer(buffer.buf), runtime.runtime_get_string_array_data_pointer(buffer.buf) + buffer_pos, tail)
                }
                buffer_pos = 0
                let v = reader.read(CHUNK_SIZE - tail)
                if (v.size > 0) {
                    runtime.memcpy(runtime.runtime_get_string_array_data_pointer(buffer.buf) + tail, runtime.runtime_get_string_array_data_pointer(v.data), v.size)
                    buffer_valid_len = tail + v.size
                } else {
                    buffer_valid_len = tail
                }
            }
            
            if (buffer_valid_len - buffer_pos >= 2) {
                let c1 = buffer.buf[buffer_pos]
                let c2 = buffer.buf[buffer_pos+1]
                
                if (c1 == '-' && c2 == '-') {
                    break // End of all parts
                } 
                if (c1 == '\r' && c2 == '\n') {
                    buffer_pos := buffer_pos + 2 // Skip \r\n, loop back to parse headers
                }
            } else {
                break
            }
        }
    },
    json() : lang.Result<json.JSONValue, ResultCode> {
        if (this.headers.headers.contains("content-type") == false || this.headers.headers["content-type"].startswith("application/json") == false) {
            return lang.Result<json.JSONValue, ResultCode>.err(ResultCode.MISMATCH_CONTENT_TYPE)
        }
        let [content, err] = this.text()
        if (err != null) {
            return lang.Result<json.JSONValue, ResultCode>.err(ResultCode.BAD_RESPONSE)
        }
        let [parsed, err2] = json.parse(content)
        if (err2 != null) {
            return lang.Result<json.JSONValue, ResultCode>.err(ResultCode.BAD_RESPONSE)
        }
        return lang.Result<json.JSONValue, ResultCode>.ok(parsed)
    },
    getch() : char {
        if (this.cached_recv == null || this.cached_recv.current_pos >= this.cached_recv.size) {
            let result = this.recv_next_raw_content()
            if (result.is_err()) {
                return '\0'
            }
            result.unwrap()
        }
        let ret = this.cached_recv.buf[this.cached_recv.current_pos]
        this.cached_recv.current_pos += 1
        return ret
    },
    recv_header() : lang.Result<Request, ResultCode> {
        let recv_s = str.Str(65536u)
        let rnrn_match_array = char[4](13, 10, 13, 10)
        let rnrn_start_pos = 0
        let current_ch = this.getch()
        while (current_ch != 0) {
            if (rnrn_match_array[rnrn_start_pos] == current_ch) {
                rnrn_start_pos += 1
                if (rnrn_start_pos == 4) {
                    break
                }
            } else {
                for (let i = 0; i < rnrn_start_pos; i += 1) {
                    recv_s.push(rnrn_match_array[i])
                }
                rnrn_start_pos = 0
                recv_s.push(current_ch)
            }
            current_ch = this.getch()
        }
        recv_s.push(13)
        recv_s.push(10)
        let parsed = http.parseHTTPRequestHeader(recv_s)
        if (parsed.is_err()) {
            return lang.Result<Request, ResultCode>.err(ResultCode.INVALID_HTTP_HEADER)
        }
        this.headers = parsed.unwrap()
        this.target = ResourceTarget(this.headers.target)
        return lang.Result<Request, ResultCode>.ok(this)
    },
    constructor(socket: socket.AbstractSocket) {
        this.socket = socket
        this.cached_recv = io.ArrayBuffer(0)
    }
}

func request(socket: socket.AbstractSocket) : lang.Result<Request, ResultCode> {
    return Request(socket).recv_header()
}
