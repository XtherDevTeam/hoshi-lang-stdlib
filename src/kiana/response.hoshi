use str "str"
use socket "net/socket"
use http "net/http"
use hashMap "hashMap"
use file "file"
use json "json"

enum HTTPResponseBodyChunkSize {
    default = 1048576
}

interface HTTPResponseBody {
    content_length() : int,
    content_type() : str.Str,
    write_to(sock: socket.AbstractSocket) : none
}

impl str.Str : HTTPResponseBody {
    content_length() : int {
        return this.length
    },
    content_type() : str.Str {
        return "text/plain"
    },
    write_to(sock: socket.AbstractSocket) : none {
        sock.send(this.data, this.length)
    }
}

impl file.AbstractFile : HTTPResponseBody {
    content_length() : int {
        return this.size() // -1 if unknown, then fallback to chunked transfer encoding
    },
    content_type() : str.Str {
        return "application/octet-stream"
    },
    write_to(sock: socket.AbstractSocket) : none {
        let content_size = this.size()
        let rn : str.Str = "\r\n"
        let rnrn0 : str.Str = "0\r\n\r\n"
        if (content_size == -1) {
            // fallback to chunked transfer encoding
            let buffer = this.read(HTTPResponseBodyChunkSize.default as int)
            while (buffer.size > 0) {
                let chunk_size_str = str.Stringable(str.Hex(buffer.size)).to_string() + "\r\n"
                sock.send(chunk_size_str.data, chunk_size_str.length)
                sock.send(buffer.data, buffer.size as unsigned)
                sock.send(rn.data, rn.length)
                buffer = this.read(HTTPResponseBodyChunkSize.default as int)
            }
            sock.send(rnrn0.data, rnrn0.length)
        } else {
            let buffer = this.read(HTTPResponseBodyChunkSize.default as int)
            while (buffer.size > 0) {
                sock.send(buffer.data, buffer.size as unsigned)
                buffer = this.read(HTTPResponseBodyChunkSize.default as int)
            }
        }
    }
}

impl json.JSONValue : HTTPResponseBody {
    content_length() : int {
        return -1 // we would like to serialize the JSON value to a string only once, no length is set, and we will use chunked transfer encoding
    },
    content_type() : str.Str {
        return "application/json"
    },
    write_to(sock: socket.AbstractSocket) : none {
        let json_str = this.to_string()
        let rn : str.Str = "\r\n"
        let rnrn0 : str.Str = "0\r\n\r\n"
        let chunk_size_str = str.Stringable(str.Hex(json_str.length)).to_string() + "\r\n"
        sock.send(chunk_size_str.data, chunk_size_str.length)
        sock.send(json_str.data, json_str.length)
        sock.send(rn.data, rn.length)
        sock.send(rnrn0.data, rnrn0.length)
    }
}

struct Response {
    headers: http.HTTPResponseHeader,
    body: HTTPResponseBody,
    constructor(headers: http.HTTPResponseHeader, body: HTTPResponseBody),
    constructor(status_code: int, status_text: str.Str, body: HTTPResponseBody),
    patch_headers() : none,
    write_to(sock: socket.AbstractSocket) : none
}

impl Response {
    constructor(headers: http.HTTPResponseHeader, body: HTTPResponseBody) {
        this.headers = headers
        this.body = body
    },
    constructor(status_code: int, status_text: str.Str, body: HTTPResponseBody) {
        this.headers = http.HTTPResponseHeader("HTTP/1.1", status_code, status_text, hashMap.HashMap<str.Str, str.Str>())
        this.body = body
    },
    patch_headers() : none {
        if (this.headers.headers.contains("content-length") == false) {
            if (this.body.content_length() != -1) {
                this.headers.add_header("content-length", str.Stringable(this.body.content_length()).to_string())
            } else {
                // set chunked transfer encoding
                this.headers.add_header("transfer-encoding", "chunked")
            }
        }
        if (this.headers.headers.contains("content-type") == false) {
            this.headers.add_header("content-type", this.body.content_type())
        }
        if (this.headers.headers.contains("server") == false) {
            this.headers.add_header("server", "hoshi-std-kiana/0.1")
        }
        return 
    },
    write_to(sock: socket.AbstractSocket) : none {
        this.patch_headers()
        let head = this.headers.to_string()
        sock.send(head.data, head.length)
        this.body.write_to(sock)
    }
}