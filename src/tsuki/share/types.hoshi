use str "str"
use vec "vec"
use json "json"

let tsuki_pm_build_number = 3 // constant for tsuki package manager build number

enum Permission {
    Administrator = 0,
    User = 1
}

struct User {
    datafield id: int,
    username: str.Str,
    description: str.Str,
    email: str.Str,
    datafield permission: int,
    constructor(id: int, username: str.Str, description: str.Str, email: str.Str, permission: int),
    static from_json(v: json.JSONValue) : User,
    to_json(): json.JSONValue
}

impl User {
    constructor(id: int, username: str.Str, description: str.Str, email: str.Str, permission: int) {
        this.id = id
        this.username = username
        this.description = description
        this.email = email
        this.permission = permission
    },
    static from_json(v: json.JSONValue) : User {
        let tree = dyn_cast<json.JSONDict>(v)
        if (tree == null) { return null }
        
        let id_val = tree["id"], username_val = tree["username"], desc_val = tree["description"], email_val = tree["email"], perm_val = tree["permission"]
        if (id_val == null || username_val == null || desc_val == null || email_val == null || perm_val == null) { return null }
        
        let id_num = dyn_cast<json.Numeric>(id_val)
        let username_str = dyn_cast<str.Str>(username_val)
        let desc_str = dyn_cast<str.Str>(desc_val)
        let email_str = dyn_cast<str.Str>(email_val)
        let perm_num = dyn_cast<json.Numeric>(perm_val)
        
        return User(
            id_num.getInt(),
            username_str,
            desc_str,
            email_str,
            perm_num.getInt()
        )
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("username", this.username)
            .put("description", this.description)
            .put("email", this.email)
            .put("permission", json.Numeric(this.permission))
    }
}

struct PackageVersion {
    datafield id: int,
    datafield package_id: int,
    tag_name: str.Str,
    revision_notes: str.Str,
    artifacts: json.JSONList,
    dependencies: json.JSONDict,
    created_at: str.Str,
    constructor(id: int, package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: json.JSONList, dependencies: json.JSONDict, created_at: str.Str),
    static from_json(v: json.JSONValue) : PackageVersion,
    to_json(): json.JSONValue
}

impl PackageVersion {
    constructor(id: int, package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: json.JSONList, dependencies: json.JSONDict, created_at: str.Str) {
        this.id = id
        this.package_id = package_id
        this.tag_name = tag_name
        this.revision_notes = revision_notes
        this.artifacts = artifacts
        this.dependencies = dependencies
        this.created_at = created_at
    },
    static from_json(v: json.JSONValue) : PackageVersion {
        let tree = dyn_cast<json.JSONDict>(v)
        if (tree == null) { return null }
        
        let id_val = tree["id"], pkg_id_val = tree["package_id"], tag_val = tree["tag_name"], rev_val = tree["revision_notes"], art_val = tree["artifacts"], dep_val = tree["dependencies"], created_val = tree["created_at"]
        if (id_val == null || pkg_id_val == null || tag_val == null || rev_val == null || art_val == null || dep_val == null || created_val == null) { return null }
        
        let id_num = dyn_cast<json.Numeric>(id_val)
        let pkg_id_num = dyn_cast<json.Numeric>(pkg_id_val)
        let tag_str = dyn_cast<str.Str>(tag_val)
        let rev_str = dyn_cast<str.Str>(rev_val)
        let art_list = dyn_cast<json.JSONList>(art_val)
        let dep_dict = dyn_cast<json.JSONDict>(dep_val)
        let created_str = dyn_cast<str.Str>(created_val)
        
        return PackageVersion(
            id_num.getInt(),
            pkg_id_num.getInt(),
            tag_str,
            rev_str,
            art_list,
            dep_dict,
            created_str
        )
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("package_id", json.Numeric(this.package_id))
            .put("tag_name", this.tag_name)
            .put("revision_notes", this.revision_notes)
            .put("artifacts", this.artifacts)
            .put("dependencies", this.dependencies)
            .put("created_at", this.created_at)
    }
}

struct PackageInformation {
    datafield id: int,
    name: str.Str,
    author: str.Str,
    description: str.Str,
    repository: str.Str,
    license: str.Str,
    readme: str.Str,
    constructor(id: int, name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str),
    static from_json(v: json.JSONValue) : PackageInformation,
    to_json(): json.JSONValue
}

impl PackageInformation {
    constructor(id: int, name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str) {
        this.id = id
        this.name = name
        this.author = author
        this.description = description
        this.repository = repository
        this.license = license
        this.readme = readme
    },
    static from_json(v: json.JSONValue) : PackageInformation {
        let tree = dyn_cast<json.JSONDict>(v)
        if (tree == null) { return null }
        
        let id_val = tree["id"], name_val = tree["name"], author_val = tree["author"], desc_val = tree["description"], repo_val = tree["repository"], lic_val = tree["license"], readme_val = tree["readme"]
        if (id_val == null || name_val == null || author_val == null || desc_val == null || repo_val == null || lic_val == null || readme_val == null) { return null }
        
        let id_num = dyn_cast<json.Numeric>(id_val)
        let name_str = dyn_cast<str.Str>(name_val)
        let author_str = dyn_cast<str.Str>(author_val)
        let desc_str = dyn_cast<str.Str>(desc_val)
        let repo_str = dyn_cast<str.Str>(repo_val)
        let lic_str = dyn_cast<str.Str>(lic_val)
        let readme_str = dyn_cast<str.Str>(readme_val)
        
        return PackageInformation(
            id_num.getInt(),
