    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("name", this.name)
            .put("author", this.author)
            .put("description", this.description)
            .put("repository", this.repository)
            .put("license", this.license)
            .put("readme", this.readme)
    }
}

struct Artifact {
    datafield id: int,
    datafield package_id: int,
    unique_id: str.Str,
    version: str.Str,
    filename: str.Str,
    mime: str.Str,
    platform: str.Str,
    arch: str.Str,
    constructor(id: int, package_id: int, unique_id: str.Str, version: str.Str, filename: str.Str, mime: str.Str, platform: str.Str, arch: str.Str),
    static from_json(v: json.JSONValue) : Artifact,
    to_json(): json.JSONValue
}

impl Artifact {
    constructor(id: int, package_id: int, unique_id: str.Str, version: str.Str, filename: str.Str, mime: str.Str, platform: str.Str, arch: str.Str) {
        this.id = id
        this.package_id = package_id
        this.unique_id = unique_id
        this.version = version
        this.filename = filename
        this.mime = mime
        this.platform = platform
        this.arch = arch
    },
    static from_json(v: json.JSONValue) : Artifact {
        let tree = dyn_cast<json.JSONDict>(v)
        if (tree == null) { return null }
        
        let id_val = tree["id"], pkg_id_val = tree["package_id"], unique_val = tree["unique_id"], ver_val = tree["version"], file_val = tree["filename"], mime_val = tree["mime"], plat_val = tree["platform"], arch_val = tree["arch"]
        if (id_val == null || pkg_id_val == null || unique_val == null || ver_val == null || file_val == null || mime_val == null || plat_val == null || arch_val == null) { return null }
        
        let id_num = dyn_cast<json.Numeric>(id_val)
        let pkg_id_num = dyn_cast<json.Numeric>(pkg_id_val)
        let unique_str = dyn_cast<str.Str>(unique_val)
        let ver_str = dyn_cast<str.Str>(ver_val)
        let file_str = dyn_cast<str.Str>(file_val)
        let mime_str = dyn_cast<str.Str>(mime_val)
        let plat_str = dyn_cast<str.Str>(plat_val)
        let arch_str = dyn_cast<str.Str>(arch_val)
        
        return Artifact(
            id_num.getInt(),
            pkg_id_num.getInt(),
            unique_str,
            ver_str,
            file_str,
            mime_str,
            plat_str,
            arch_str
        )
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("id", json.Numeric(this.id))
            .put("package_id", json.Numeric(this.package_id))
            .put("unique_id", this.unique_id)
            .put("version", this.version)
            .put("filename", this.filename)
            .put("mime", this.mime)
            .put("platform", this.platform)
            .put("arch", this.arch)
    }
}