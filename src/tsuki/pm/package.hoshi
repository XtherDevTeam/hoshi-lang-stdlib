use json "json"
use str "str"
use hashMap "hashMap"
use vec "vec"
use lang "builtin"

struct NativePlatformConfig {
    libraries: vec.Vec<str.Str>,
    link_flags: vec.Vec<str.Str>,
    compile_flags: vec.Vec<str.Str>,
    constructor(),
    constructor(libraries: vec.Vec<str.Str>, link_flags: vec.Vec<str.Str>, compile_flags: vec.Vec<str.Str>),
    static from_json(obj: json.JSONValue) : NativePlatformConfig,
    to_json() : json.JSONValue
}

impl NativePlatformConfig {
    constructor() {
        this.libraries = vec.Vec<str.Str>()
        this.link_flags = vec.Vec<str.Str>()
        this.compile_flags = vec.Vec<str.Str>()
    },
    constructor(libraries: vec.Vec<str.Str>, link_flags: vec.Vec<str.Str>, compile_flags: vec.Vec<str.Str>) {
        this.libraries = libraries
        this.link_flags = link_flags
        this.compile_flags = compile_flags
    },
    static from_json(obj: json.JSONValue) : NativePlatformConfig {
        let tree = dyn_cast<json.JSONDict>(obj)
        let config = NativePlatformConfig()
        if (tree == null) {
            return config
        }

        if (tree.contains("libraries") && tree["libraries"] interfaceof json.JSONList) {
            let libs = dyn_cast<json.JSONList>(tree["libraries"])
            for (let i = 0; i < libs.length; i += 1) {
                let lib = dyn_cast<str.Str>(libs[i])
                if (lib != null) {
                    config.libraries.push(lib)
                }
            }
        }

        if (tree.contains("link_flags") && tree["link_flags"] interfaceof json.JSONList) {
            let flags = dyn_cast<json.JSONList>(tree["link_flags"])
            for (let i = 0; i < flags.length; i += 1) {
                let flag = dyn_cast<str.Str>(flags[i])
                if (flag != null) {
                    config.link_flags.push(flag)
                }
            }
        }

        if (tree.contains("compile_flags") && tree["compile_flags"] interfaceof json.JSONList) {
            let flags = dyn_cast<json.JSONList>(tree["compile_flags"])
            for (let i = 0; i < flags.length; i += 1) {
                let flag = dyn_cast<str.Str>(flags[i])
                if (flag != null) {
                    config.compile_flags.push(flag)
                }
            }
        }

        return config
    },
    to_json() : json.JSONValue {
        let libs_arr = json.JSONList()
        for (let i = 0; i < this.libraries.length; i += 1) {
            libs_arr.push(this.libraries[i])
        }
        let link_arr = json.JSONList()
        for (let i = 0; i < this.link_flags.length; i += 1) {
            link_arr.push(this.link_flags[i])
        }
        let compile_arr = json.JSONList()
        for (let i = 0; i < this.compile_flags.length; i += 1) {
            compile_arr.push(this.compile_flags[i])
        }
        return json.JSONDict()
            .put("libraries", libs_arr)
            .put("link_flags", link_arr)
            .put("compile_flags", compile_arr)
    }
}

struct NativeConfig {
    darwin: NativePlatformConfig,
    linux: NativePlatformConfig,
    windows: NativePlatformConfig,
    constructor(),
    static from_json(obj: json.JSONValue) : NativeConfig,
    to_json() : json.JSONValue,
    get_for_platform(platform: str.Str) : NativePlatformConfig
}

impl NativeConfig {
    constructor() {
        this.darwin = NativePlatformConfig()
        this.linux = NativePlatformConfig()
        this.windows = NativePlatformConfig()
    },
    static from_json(obj: json.JSONValue) : NativeConfig {
        let tree = dyn_cast<json.JSONDict>(obj)
        let config = NativeConfig()
        if (tree == null) {
            return config
        }

        if (tree.contains("darwin")) {
            config.darwin = NativePlatformConfig.from_json(tree["darwin"])
        }
        if (tree.contains("linux")) {
            config.linux = NativePlatformConfig.from_json(tree["linux"])
        }
        if (tree.contains("windows")) {
            config.windows = NativePlatformConfig.from_json(tree["windows"])
        }

        return config
    },
    to_json() : json.JSONValue {
        return json.JSONDict()
            .put("darwin", this.darwin.to_json())
            .put("linux", this.linux.to_json())
            .put("windows", this.windows.to_json())
    },
    get_for_platform(platform: str.Str) : NativePlatformConfig {
        if (platform == "darwin") {
            return this.darwin
        } elif (platform == "linux") {
            return this.linux
        } elif (platform == "win32") {
            return this.windows
        }
        return NativePlatformConfig()
    }
}

struct PackageManifest {
    name: str.Str,
    version: str.Str,
    author: str.Str,
    repository: str.Str,
    license: str.Str,
    dependencies: hashMap.HashMap<str.Str, str.Str>,
    native: NativeConfig,
    constructor(),
    constructor(name: str.Str, version: str.Str, author: str.Str, repository: str.Str, license: str.Str, dependencies: hashMap.HashMap<str.Str, str.Str>, native: NativeConfig),
    set_name(name: str.Str) : PackageManifest,
    set_version(version: str.Str) : PackageManifest,
    set_author(author: str.Str) : PackageManifest,
    set_repository(repository: str.Str) : PackageManifest,
    set_license(license: str.Str) : PackageManifest,
    set_dependencies(dependencies: hashMap.HashMap<str.Str, str.Str>) : PackageManifest,
    set_native(native: NativeConfig) : PackageManifest,
    static from_json(obj: json.JSONValue) : lang.Result<PackageManifest, str.Str>,
    to_json() : json.JSONValue
}

impl PackageManifest {
    constructor() {
        this.native = NativeConfig()
    },
    constructor(name: str.Str, version: str.Str, author: str.Str, repository: str.Str, license: str.Str, dependencies: hashMap.HashMap<str.Str, str.Str>, native: NativeConfig) {
        this.name = name
        this.version = version
        this.author = author
        this.repository = repository
        this.license = license
        this.dependencies = dependencies
        this.native = native
    },
    set_name(name: str.Str) : PackageManifest {
        this.name = name
        return this
    },
    set_version(version: str.Str) : PackageManifest {
        this.version = version
        return this
    },
    set_author(author: str.Str) : PackageManifest {
        this.author = author
        return this
    },
    set_repository(repository: str.Str) : PackageManifest {
        this.repository = repository
        return this
    },
    set_license(license: str.Str) : PackageManifest {
        this.license = license
        return this
    },
    set_dependencies(dependencies: hashMap.HashMap<str.Str, str.Str>) : PackageManifest {
        this.dependencies = dependencies
        return this
    },
    set_native(native: NativeConfig) : PackageManifest {
        this.native = native
        return this
    },
    static from_json(obj: json.JSONValue) : lang.Result<PackageManifest, str.Str> {
        let tree = dyn_cast<json.JSONDict>(obj)
        if (tree == null) {
            return lang.Result<PackageManifest, str.Str>.err("Expected a JSON object")
        }
        let name = tree["name"], version = tree["version"], author = tree["author"], repository = tree["repository"], license = tree["license"], dependencies = tree["dependencies"]
        if (name == null || version == null || author == null || repository == null || license == null || dependencies == null) {
            return lang.Result<PackageManifest, str.Str>.err("Invalid properties in JSON object")
        }
        let name_str = dyn_cast<str.Str>(name)
        let version_str = dyn_cast<str.Str>(version)
        let author_str = dyn_cast<str.Str>(author)
        let repository_str = dyn_cast<str.Str>(repository)
        let license_str = dyn_cast<str.Str>(license)
        if (name_str == null || version_str == null || author_str == null || repository_str == null || license_str == null) {
            return lang.Result<PackageManifest, str.Str>.err("Invalid properties in JSON object")
        }
        let dependencies_obj = dyn_cast<json.JSONDict>(dependencies)
        if (dependencies_obj == null) {
            return lang.Result<PackageManifest, str.Str>.err("Invalid dependencies property in JSON object")
        }
        let dependencies_map = hashMap.HashMap<str.Str, str.Str>()
        let dependencies_keys = dependencies_obj.keys()
        for (let i = 0;i < dependencies_keys.length;i += 1) {
            let key = dependencies_keys[i]
            let value = dependencies_obj[key]
            let value_str = dyn_cast<str.Str>(value)
            if (value_str == null) {
                return lang.Result<PackageManifest, str.Str>.err("Invalid dependencies property in JSON object")
            }
            dependencies_map.put(key, value_str)
        }

        let native_config = NativeConfig()
        if (tree.contains("native")) {
            native_config = NativeConfig.from_json(tree["native"])
        }

        return lang.Result<PackageManifest, str.Str>.ok(PackageManifest(name_str, version_str, author_str, repository_str, license_str, dependencies_map, native_config))
    },
    to_json() : json.JSONValue {
        let dependencies_obj = json.JSONDict()
        let dependencies_keys = this.dependencies.keys()
        for (let i = 0; i < dependencies_keys.length; i += 1) {
            let key = dependencies_keys[i]
            let value = this.dependencies[key]
            dependencies_obj.put(key, value)
        }
        let obj = json.JSONDict()
            .put("name", this.name)
            .put("version", this.version)
            .put("dependencies", dependencies_obj)
            .put("author", this.author)
            .put("repository", this.repository)
            .put("license", this.license)
            .put("native", this.native.to_json())
        return obj
    }
}

