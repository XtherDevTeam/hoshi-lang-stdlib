use str "str"
use lang "builtin"
use console "console"
use vec "vec"
use tsuki "tsuki"

func print_help(self: str.Str) : none {
    let help_msg = str.format("tsuki-update tool for hoshi-lang
Usage: {} [options]

Options:
  -h, --help      Show help message
  -v, --version   Specify version to install
  -y, --yes       Automatically select latest version and skip prompts
", self)
    console.print(help_msg)
}

func main() : int {
    let argv = lang.argv()
    let version : str.Str = ""
    let force = false

    for (let i = 1; i < argv.length; i += 1) {
        let arg : str.Str = argv[i]
        if (arg == "-h" || arg == "--help") {
            print_help(argv[0])
            return 0
        } elif (arg == "-v" || arg == "--version") {
            if (i + 1 < argv.length) {
                version = argv[i+1]
                i += 1
            }
        } elif (arg == "-y" || arg == "--yes") {
            force = true
        } else {
            console.print(str.format("Unknown argument: {}\n", arg))
            print_help(argv[0])
            return 1
        }
    }

    return tsuki.install.github.updater(version, force)
}
