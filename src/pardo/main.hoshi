use pardo "pardo"
use str "str"
use hashMap "hashMap"
use lang "builtin"
use console "console"
use fs "fs"
use json "json"

func print_help(self: str.Str) : none {
    let help_msg = str.format("pardo package manager for hoshi-lang
Made with love by Jerry Chou (This project is licensed under the MIT License)
Usage: {} <command> [options]

Commands:
  init           Initialize a new pardo.json and build.json manifest
  install        Install dependencies from pardo.json
  remove         Remove an installed package and update pardo.json
  build          Build targets specified in build.json
  package        Build and package the current project into a zip artifact

Options:
  -h, --help      Show help message
  -g, --global    Use global package manager
  --build-number  Print the build number of pardo
", self)
    console.print(help_msg)
}

func load_pardo_manifest() : lang.Result<pardo.pm.package.PackageManifest, str.Str> {
    let manifest_path = "pardo.json"
    if (fs.Path(manifest_path).exists() == false) {
        return lang.Result<pardo.pm.package.PackageManifest, str.Str>.err("pardo.json not found")
    }
    
    let f_res = fs.open(manifest_path, "r")
    if (f_res.is_err()) {
        return lang.Result<pardo.pm.package.PackageManifest, str.Str>.err("Could not open pardo.json")
    }
    let f = f_res.unwrap()
    let data = f.read(f.size())
    let json_res = json.parse(str.Str(data.data))
    if (json_res.is_err()) {
        return lang.Result<pardo.pm.package.PackageManifest, str.Str>.err("Failed to parse pardo.json")
    }
    return pardo.pm.package.PackageManifest.from_json(json_res.unwrap())
}

func load_build_manifest() : lang.Result<pardo.pm.package.BuildManifest, str.Str> {
    let manifest_path = "build.json"
    if (fs.Path(manifest_path).exists() == false) {
        // Return a default build manifest if not found, as per "be relax" instruction
        return lang.Result<pardo.pm.package.BuildManifest, str.Str>.ok(pardo.pm.package.BuildManifest())
    }
    
    let f_res = fs.open(manifest_path, "r")
    if (f_res.is_err()) {
        return lang.Result<pardo.pm.package.BuildManifest, str.Str>.err("Could not open build.json")
    }
    let f = f_res.unwrap()
    let data = f.read(f.size())
    let json_res = json.parse(str.Str(data.data))
    if (json_res.is_err()) {
        // Return default on parse failure too if we want to be very relax, but maybe error is better here
        return lang.Result<pardo.pm.package.BuildManifest, str.Str>.ok(pardo.pm.package.BuildManifest())
    }
    return pardo.pm.package.BuildManifest.from_json(json_res.unwrap())
}

func main() : int {
    let argv = lang.argv()
    
    // Check for build-number first to be similar to hoshi-lang
    for (let i = 1; i < argv.length; i += 1) {
        if (argv[i] == "--build-number") {
            console.print("1\n")
            return 0
        }
    }

    if (pardo.install.github.detect_existing_hoshi_installation() == "") {
        console.print("No existing hoshi installation found. Running setup...\n")
        pardo.install.github.installer("", "")
    }

    let is_global = false
    let command : str.Str = ""
    for (let i = 1; i < argv.length; i += 1) {
        let arg : str.Str = argv[i]
        if (arg == "-h" || arg == "--help") {
            print_help(argv[0])
            return 0
        } elif (arg == "-g" || arg == "--global") {
            is_global = true
        } elif (command == "") {
            command = arg
        }
    }

    let pm : pardo.pm.instance.PackageManagementBackend = null
    if (is_global) {
        pm = pardo.pm.management.GlobalPackageManager()
    } else {
        pm = pardo.pm.management.ProjectLocalPackageManager()
    }

    if (command == "init") {
        let pkg_name : str.Str = ""
        for (let i = 1; i < argv.length; i += 1) {
            let arg : str.Str = argv[i]
            if (arg != "init" && arg != "-g" && arg != "--global") {
                pkg_name = arg
                break
            }
        }
        if (pkg_name == "") {
            pkg_name = fs.Path.current_dir().filename()
        }
        
        let result = pm.init(pkg_name)
        if (result.is_err()) {
            console.print(str.format("Initialization failed: {}\n", result.unwrap_err()))
            return 1
        }
        console.print("Successfully initialized project manifests\n")
        return 0
    }

    if (command == "install") {
        let manifest_res = load_pardo_manifest()
        if (manifest_res.is_err()) {
            console.print(str.format("Error: {}\n", manifest_res.unwrap_err()))
            return 1
        }
        
        let source = pardo.pm.resolve.DefaultPackageSource()
        let result = pm.install(manifest_res.unwrap(), source)
        if (result.is_err()) {
            console.print(str.format("Installation failed: {}\n", result.unwrap_err()))
            return 1
        }
        console.print("Installation successful!\n")
        return 0
    }

    if (command == "remove") {
        let pkg_to_remove : str.Str = ""
        for (let i = 1; i < argv.length; i += 1) {
            let arg : str.Str = argv[i]
            if (arg != "remove" && arg != "-g" && arg != "--global") {
                pkg_to_remove = arg
                break
            }
        }
        
        if (pkg_to_remove == "") {
            console.print("Error: Please specify a package name to remove.\n")
            return 1
        }

        let manifest : pardo.pm.package.PackageManifest = null
        if (is_global == false) {
            let manifest_res = load_pardo_manifest()
            if (manifest_res.is_ok()) {
                manifest = manifest_res.unwrap()
            }
        }
        
        let result = pm.remove(pkg_to_remove, manifest)
        if (result.is_err()) {
            console.print(str.format("Removal failed: {}\n", result.unwrap_err()))
            return 1
        }
        return 0
    }

    if (command == "build" || command == "package") {
        let manifest_res = load_pardo_manifest()
        if (manifest_res.is_err()) {
            console.print(str.format("Error: {}\n", manifest_res.unwrap_err()))
            return 1
        }
        
        let build_manifest_res = load_build_manifest()
        if (build_manifest_res.is_err()) {
            console.print(str.format("Error: {}\n", build_manifest_res.unwrap_err()))
            return 1
        }
        
        let result : lang.Result<bool, str.Str> = null
        if (command == "build") {
            result = pm.build(manifest_res.unwrap(), build_manifest_res.unwrap())
        } else {
            result = pm.package(manifest_res.unwrap(), build_manifest_res.unwrap())
        }
        
        if (result.is_err()) {
            console.print(str.format("{} failed: {}\n", command, result.unwrap_err()))
            return 1
        }
        console.print(str.format("{} successful!\n", command))
        return 0
    }

    if (command == "") {
        print_help(argv[0])
    } else {
        console.print(str.format("Unknown command: {}\n", command))
        print_help(argv[0])
    }

    return 0
}