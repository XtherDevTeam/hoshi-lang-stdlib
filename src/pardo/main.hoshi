use pardo "pardo"
use str "str"
use hashMap "hashMap"
use lang "builtin"
use console "console"
use fs "fs"
use json "json"
use registry "pm/registry"
use vec "vec"

func print_help(self: str.Str) : none {
    let help_msg = str.format("pardo package manager for hoshi-lang
Made with love by Jerry Chou (This project is licensed under the MIT License)

Usage: {} <command> [options] [args]

Commands:
  init           Initialize a new pardo.json and build.json manifest
  install        Install dependencies from pardo.json
  remove         Remove an installed package and update pardo.json
  build          Build targets specified in build.json
  package        Build and package the current project into a zip artifact
  update         Update hoshi-lang and pardo installations
  
Remote Management:
  login          Authenticate with a remote registry
  logout         Terminal current session
  whoami         Show current user information
  publish        Publish current package to the registry

Options:
  -h, --help      Show help message
  -g, --global    Use global package manager
  -r, --registry  Specify package registry URL
  --build-number  Print the build number of pardo
", self)
    console.print(help_msg)
}

func load_pardo_manifest() : lang.Result<pardo.pm.package.PackageManifest, str.Str> {
    let manifest_path = "pardo.json"
    if (fs.Path(manifest_path).exists() == false) {
        return lang.Result<pardo.pm.package.PackageManifest, str.Str>.err("pardo.json not found")
    }
    
    let f_res = fs.open(manifest_path, "r")
    if (f_res.is_err()) {
        return lang.Result<pardo.pm.package.PackageManifest, str.Str>.err("Could not open pardo.json")
    }
    let f = f_res.unwrap()
    let data = f.read(f.size())
    let json_res = json.parse(str.Str(data.data))
    if (json_res.is_err()) {
        return lang.Result<pardo.pm.package.PackageManifest, str.Str>.err("Failed to parse pardo.json")
    }
    return pardo.pm.package.PackageManifest.from_json(json_res.unwrap())
}

func load_build_manifest() : lang.Result<pardo.pm.package.BuildManifest, str.Str> {
    let manifest_path = "build.json"
    if (fs.Path(manifest_path).exists() == false) {
        return lang.Result<pardo.pm.package.BuildManifest, str.Str>.ok(pardo.pm.package.BuildManifest())
    }
    
    let f_res = fs.open(manifest_path, "r")
    if (f_res.is_err()) {
        return lang.Result<pardo.pm.package.BuildManifest, str.Str>.err("Could not open build.json")
    }
    let f = f_res.unwrap()
    let data = f.read(f.size())
    let json_res = json.parse(str.Str(data.data))
    if (json_res.is_err()) {
        return lang.Result<pardo.pm.package.BuildManifest, str.Str>.ok(pardo.pm.package.BuildManifest())
    }
    return pardo.pm.package.BuildManifest.from_json(json_res.unwrap())
}

func main() : int {
    let argv = lang.argv()
    
    if (pardo.install.github.detect_existing_hoshi_installation() == "") {
        console.print("No existing hoshi installation found. Running setup...\n")
        pardo.install.github.installer("", "")
    }

    let is_global = false
    let registry_url : str.Str = "https://www.xiaokang00010.top:62112/api" // Default registry
    let command : str.Str = ""
    let args = vec.Vec<str.Str>()

    // Improved argument parsing
    for (let i = 1; i < argv.length; i += 1) {
        let arg : str.Str = argv[i]
        if (arg == "-h" || arg == "--help") {
            print_help(argv[0])
            return 0
        } elif (arg == "--build-number") {
            console.print("1\n")
            return 0
        } elif (arg == "-g" || arg == "--global") {
            is_global = true
        } elif (arg == "-r" || arg == "--registry") {
            if (i + 1 < argv.length) {
                registry_url = argv[i+1]
                i += 1
            }
        } elif (command == "") {
            command = arg
        } else {
            args.push(arg)
        }
    }

    if (command == "") {
        print_help(argv[0])
        return 0
    }

    let pm : pardo.pm.instance.PackageManagementBackend = null
    if (is_global) {
        pm = pardo.pm.management.GlobalPackageManager()
    } else {
        pm = pardo.pm.management.ProjectLocalPackageManager()
    }

    if (command == "init") {
        let pkg_name = fs.Path.current_dir().filename()
        if (args.length > 0) { pkg_name = args[0] }
        
        let result = pm.init(pkg_name)
        if (result.is_err()) {
            console.print(str.format("Initialization failed: {}\n", result.unwrap_err()))
            return 1
        }
        console.print("Successfully initialized project manifests\n")
        return 0
    }

    if (command == "install") {
        let pkg_to_install : str.Str = ""
        if (args.length > 0) { pkg_to_install = args[0] }

        let source_impl = pardo.pm.resolve.DefaultPackageSource()
        if (registry_url != "") {
            source_impl.set_remote(registry_url)
        }
        let source : pardo.pm.package.PackageSource = source_impl

        let manifest : pardo.pm.package.PackageManifest = null
        if (is_global) {
            manifest = pardo.pm.package.PackageManifest("global-install", "1.0.0", "", "", "", hashMap.HashMap<str.Str, str.Str>())
        } else {
            let manifest_res = load_pardo_manifest()
            if (manifest_res.is_err()) {
                console.print(str.format("Error: {}\n", manifest_res.unwrap_err()))
                return 1
            }
            manifest = manifest_res.unwrap()
        }

        if (pkg_to_install != "") {
            let pkg_name = pkg_to_install
            let pkg_version = str.Str("")
            if (pkg_to_install.find("@") != -1) {
                let parts = pkg_to_install.split("@")
                if (parts.length >= 2) {
                    pkg_name = parts[0]
                    pkg_version = parts[1]
                }
            }

            if (pkg_version == "") {
                console.print(str.format("Resolving latest version for {}...\n", pkg_name))
                let pkg_info_res = source.query_package(pkg_name)
                if (pkg_info_res.is_err()) {
                    console.print(str.format("Error: Could not find package {}\n", pkg_name))
                    return 1
                }
                let pkg_info = pkg_info_res.unwrap()
                if (pkg_info.versions.length == 0) {
                    console.print(str.format("Error: No versions found for package {}\n", pkg_name))
                    return 1
                }
                pkg_version = ">=" + pkg_info.versions[0]
            }
            manifest.dependencies.put(pkg_name, pkg_version)
        }
        
        let result = pm.install(manifest, source)
        if (result.is_err()) {
            console.print(str.format("Installation failed: {}\n", result.unwrap_err()))
            return 1
        }
        console.print("Installation successful!\n")
        return 0
    }

    if (command == "remove") {
        if (args.length == 0) {
            console.print("Error: Please specify a package name to remove.\n")
            return 1
        }
        let pkg_to_remove = args[0]

        let manifest : pardo.pm.package.PackageManifest = null
        if (is_global == false) {
            let manifest_res = load_pardo_manifest()
            if (manifest_res.is_ok()) {
                manifest = manifest_res.unwrap()
            } else {
                console.print("Error: unable to load pardo.json\n")
                return 1
            }
        }
        
        let result = pm.remove(pkg_to_remove, manifest)
        if (result.is_err()) {
            console.print(str.format("Removal failed: {}\n", result.unwrap_err()))
            return 1
        }
        return 0
    }

    if (command == "build" || command == "package") {
        let manifest_res = load_pardo_manifest()
        if (manifest_res.is_err()) {
            console.print(str.format("Error: {}\n", manifest_res.unwrap_err()))
            return 1
        }
        let build_manifest_res = load_build_manifest()
        if (build_manifest_res.is_err()) {
            console.print(str.format("Error: {}\n", build_manifest_res.unwrap_err()))
            return 1
        }
        
        let result : lang.Result<bool, str.Str> = null
        if (command == "build") {
            result = pm.build(manifest_res.unwrap(), build_manifest_res.unwrap())
        } else {
            result = pm.package(manifest_res.unwrap(), build_manifest_res.unwrap())
        }
        
        if (result.is_err()) {
            console.print(str.format("{} failed: {}\n", command, result.unwrap_err()))
            return 1
        }
        console.print(str.format("{} successful!\n", command))
        return 0
    }

    // Remote Specific Commands
    let remote = registry.PardoRegistryRemote(registry_url)

    if (command == "login") {
        if (args.length < 2) {
            console.print("Usage: pardo login <username> <password>\n")
            return 1
        }
        let result = remote.login(args[0], args[1])
        if (result.is_err()) {
            console.print("Login failed: ", result.unwrap_err(), "\n")
            return 1
        }
        console.print("Login successful!\n")
        return 0
    }

    if (command == "logout") {
        let result = remote.logout()
        if (result.is_err()) {
            console.print("Logout failed:", result.unwrap_err(), "\n")
            return 1
        }
        console.print("Logged out successfully.\n")
        return 0
    }

    if (command == "whoami") {
        let result = remote.whoami()
        if (result.is_err()) {
            console.print("Error:", result.unwrap_err(), "\n")
            return 1
        }
        let user = result.unwrap()
        console.print("Logged in as:", user.username, "(", user.email, ")\n")
        console.print("Description:", user.description, "\n")
        return 0
    }

    if (command == "publish") {
        let manifest_res = load_pardo_manifest()
        if (manifest_res.is_err()) {
            console.print("Error loading manifest: ", manifest_res.unwrap_err(), "\n")
            return 1
        }
        let build_manifest_res = load_build_manifest()
        if (build_manifest_res.is_err()) {
            console.print("Error loading build manifest: ", build_manifest_res.unwrap_err(), "\n")
            return 1
        }

        // 1. Build and package first
        console.print("Building and packaging artifact...\n")
        let pkg_res = pm.package(manifest_res.unwrap(), build_manifest_res.unwrap())
        if (pkg_res.is_err()) {
            console.print("Package process failed: ", pkg_res.unwrap_err(), "\n")
            return 1
        }

        // 2. Publish to remote
        let result = remote.publish(manifest_res.unwrap(), build_manifest_res.unwrap())
        if (result.is_err()) {
            console.print("Publish failed: ", result.unwrap_err(), "\n")
            return 1
        }
        return 0
    }

    if (command == "update") {
        let version : str.Str = ""
        let force = false
        for (let i = 0; i < args.length; i += 1) {
            if (args[i] == "-v" || args[i] == "--version") {
                if (i + 1 < args.length) {
                    version = args[i+1]
                    i += 1
                }
            } elif (args[i] == "-y" || args[i] == "--yes") {
                force = true
            }
        }
        return pardo.install.github.updater(version, force)
    }

    console.print(str.format("Unknown command: {}\n", command))
    print_help(argv[0])
    return 1
}