struct PackageInformation {
    name: str.Str,
    author: str.Str,
    repository: str.Str,
    license: str.Str,
    versions: vec.Vec<str.Str>,
    constructor(),
    constructor(name: str.Str, author: str.Str, repository: str.Str, license: str.Str, versions: vec.Vec<str.Str>),
    static from_json(obj: json.JSONValue) : lang.Result<PackageInformation, str.Str>,
    to_json() : json.JSONValue,
    set_name(name: str.Str) : PackageInformation,
    set_author(author: str.Str) : PackageInformation,
    set_repository(repository: str.Str) : PackageInformation,
    set_license(license: str.Str) : PackageInformation,
    set_versions(versions: vec.Vec<str.Str>) : PackageInformation
}

impl PackageInformation {
    constructor() {

    },
    constructor(name: str.Str, author: str.Str, repository: str.Str, license: str.Str, versions: vec.Vec<str.Str>) {
        this.name = name
        this.author = author
        this.repository = repository
        this.license = license
        this.versions = versions
    },
    set_name(name: str.Str) : PackageInformation {
        this.name = name
        return this
    },
    set_author(author: str.Str) : PackageInformation {
        this.author = author
        return this
    },
    set_repository(repository: str.Str) : PackageInformation {
        this.repository = repository
        return this
    },
    set_license(license: str.Str) : PackageInformation {
        this.license = license
        return this
    },
    set_versions(versions: vec.Vec<str.Str>) : PackageInformation {
        this.versions = versions
        return this
    },
    static from_json(obj: json.JSONValue) : lang.Result<PackageInformation, str.Str> {
        let tree = dyn_cast<json.JSONDict>(obj)
        if (tree == null) {
            return lang.Result<PackageInformation, str.Str>.err("Expected a JSON object")
        }
        let name = tree["name"], author = tree["author"], repository = tree["repository"], license = tree["license"], versions = tree["versions"]
        if (name == null || author == null || repository == null || license == null || versions == null) {
            return lang.Result<PackageInformation, str.Str>.err("Invalid properties in JSON object")
        }
        let name_str = dyn_cast<str.Str>(name)
        let author_str = dyn_cast<str.Str>(author)
        let repository_str = dyn_cast<str.Str>(repository)
        let license_str = dyn_cast<str.Str>(license)
        let versions_arr = dyn_cast<json.JSONList>(versions)
        if (name_str == null || author_str == null || repository_str == null || license_str == null || versions_arr == null) {
            return lang.Result<PackageInformation, str.Str>.err("Invalid properties in JSON object")
        }
        let versions_vec = vec.Vec<str.Str>()
        for (let i = 0; i < versions_arr.length; i += 1) {
            let version = versions_arr[i]
            let version_str = dyn_cast<str.Str>(version)
            if (version_str == null) {
                return lang.Result<PackageInformation, str.Str>.err("Invalid versions property in JSON object")
            }
            versions_vec.push(version_str)
        }
        return lang.Result<PackageInformation, str.Str>.ok(PackageInformation(name_str, author_str, repository_str, license_str, versions_vec))
    },
    to_json() : json.JSONValue {
        let versions_arr = json.JSONList()
        for (let i = 0; i < this.versions.length; i += 1) {
            let version = this.versions[i]
            versions_arr.push(version)
        }
        let obj = json.JSONDict()
            .put("name", this.name)
            .put("author", this.author)
            .put("repository", this.repository)
            .put("license", this.license)
            .put("versions", versions_arr)
        return obj
    }

}

enum PackageSourceQueryResultCode {
    Success,
    NetworkError,
    NotFound,
    InvalidManifest
}

interface PackageSource {
    get_name() : str.Str,
    query_package(name: str.Str) : lang.Result<PackageInformation, PackageSourceQueryResultCode>,
    query_package_manifest(name: str.Str, version: str.Str) : lang.Result<PackageManifest, PackageSourceQueryResultCode>,
    query_asset_url(name: str.Str, version: str.Str, platform: str.Str, arch: str.Str) : str.Str
}

struct BuildTarget {
    type: str.Str,
    filename: str.Str,
    sourcefile: str.Str,
    flags: str.Str,
    platform: str.Str,
    arch: str.Str,
    defines: hashMap.HashMap<str.Str, str.Str>,
    visible: bool,
    constructor(),
    constructor(type: str.Str, filename: str.Str, sourcefile: str.Str, flags: str.Str, platform: str.Str, arch: str.Str, defines: hashMap.HashMap<str.Str, str.Str>, visible: bool),
    static from_json(obj: json.JSONValue) : BuildTarget,
    to_json() : json.JSONValue
}

impl BuildTarget {
    constructor() {
        this.type = "binary"
        this.filename = ""
        this.sourcefile = "src/main.hoshi"
        this.flags = ""
        this.platform = "universal"
        this.arch = "universal"
        this.defines = hashMap.HashMap<str.Str, str.Str>()
        this.visible = true
    },
    constructor(type: str.Str, filename: str.Str, sourcefile: str.Str, flags: str.Str, platform: str.Str, arch: str.Str, defines: hashMap.HashMap<str.Str, str.Str>, visible: bool) {
        this.type = type
        this.filename = filename
        this.sourcefile = sourcefile
        this.flags = flags
        this.platform = platform
        this.arch = arch
        this.defines = defines
        this.visible = visible
    },
    static from_json(obj: json.JSONValue) : BuildTarget {
        let tree = dyn_cast<json.JSONDict>(obj)
        if (tree == null) {
            return BuildTarget()
        }
        
        let target = BuildTarget()
        
        if (tree.contains("type") && tree["type"] interfaceof str.Str) {
            target.type = dyn_cast<str.Str>(tree["type"])
        }
        
        if (tree.contains("filename") && tree["filename"] interfaceof str.Str) {
            target.filename = dyn_cast<str.Str>(tree["filename"])
        }
        
        if (tree.contains("sourcefile") && tree["sourcefile"] interfaceof str.Str) {
            target.sourcefile = dyn_cast<str.Str>(tree["sourcefile"])
        }
        
        if (tree.contains("flags") && tree["flags"] interfaceof str.Str) {
            target.flags = dyn_cast<str.Str>(tree["flags"])
        }
        
        if (tree.contains("platform") && tree["platform"] interfaceof str.Str) {
            target.platform = dyn_cast<str.Str>(tree["platform"])
        }

        if (tree.contains("arch") && tree["arch"] interfaceof str.Str) {
            target.arch = dyn_cast<str.Str>(tree["arch"])
        }
        
        if (tree.contains("visible") && tree["visible"] interfaceof bool) {
            target.visible = dyn_cast<bool>(tree["visible"])
        }
        
        if (tree.contains("defines") && tree["defines"] interfaceof json.JSONDict) {
            let defines_dict = dyn_cast<json.JSONDict>(tree["defines"])
            let keys = defines_dict.keys()
            for (let i = 0; i < keys.length; i += 1) {
                let key = keys[i]
                let val = defines_dict[key]
                if (val interfaceof str.Str) {
                    target.defines.put(key, dyn_cast<str.Str>(val))
                }
            }
        }
        
        return target
    },
    to_json() : json.JSONValue {
        let defines_obj = json.JSONDict()
        let keys = this.defines.keys()
        for (let i = 0; i < keys.length; i += 1) {
            let key = keys[i]
            defines_obj.put(key, this.defines[key])
        }
        
        let obj = json.JSONDict()
            .put("type", this.type)
            .put("filename", this.filename)
            .put("sourcefile", this.sourcefile)
            .put("flags", this.flags)
            .put("platform", this.platform)
            .put("arch", this.arch)
            .put("visible", this.visible)
            .put("defines", defines_obj)
        return obj
    }
}

struct BuildManifest {
    minimum_pm_version: int,
    minimum_hoshi_build: int,
    targets: hashMap.HashMap<str.Str, BuildTarget>,
    constructor(),
    constructor(pm_ver: int, hoshi_build: int, targets: hashMap.HashMap<str.Str, BuildTarget>),
    static from_json(obj: json.JSONValue) : lang.Result<BuildManifest, str.Str>,
    to_json() : json.JSONValue
}

impl BuildManifest {
    constructor() {
        this.minimum_pm_version = 0
        this.minimum_hoshi_build = 0
        this.targets = hashMap.HashMap<str.Str, BuildTarget>()
    },
    constructor(pm_ver: int, hoshi_build: int, targets: hashMap.HashMap<str.Str, BuildTarget>) {
        this.minimum_pm_version = pm_ver
        this.minimum_hoshi_build = hoshi_build
        this.targets = targets
    },
    static from_json(obj: json.JSONValue) : lang.Result<BuildManifest, str.Str> {
        let tree = dyn_cast<json.JSONDict>(obj)
        if (tree == null) {
            return lang.Result<BuildManifest, str.Str>.err("Expected a JSON object for BuildManifest")
        }
        
        let pm_ver = 0
        let hoshi_build = 0
        
        let pm_ver_val = tree["minimum_pm_version"]
        if (pm_ver_val != null && pm_ver_val interfaceof json.Numeric) {
            let pm_ver_num = dyn_cast<json.Numeric>(pm_ver_val)
            pm_ver = pm_ver_num.getInt()
        }
        
        let hoshi_build_val = tree["minimum_hoshi_build"]
        if (hoshi_build_val != null && hoshi_build_val interfaceof json.Numeric) {
            let hoshi_build_num = dyn_cast<json.Numeric>(hoshi_build_val)
            hoshi_build = hoshi_build_num.getInt()
        }
        
        let targets_map = hashMap.HashMap<str.Str, BuildTarget>()
        let targets_val = tree["targets"]
        if (targets_val != null && targets_val interfaceof json.JSONDict) {
            let targets_dict = dyn_cast<json.JSONDict>(targets_val)
            let keys = targets_dict.keys()
            for (let i = 0; i < keys.length; i += 1) {
                let key = keys[i]
                targets_map.put(key, BuildTarget.from_json(targets_dict[key]))
            }
        }
        
        return lang.Result<BuildManifest, str.Str>.ok(BuildManifest(pm_ver, hoshi_build, targets_map))
    },
    to_json() : json.JSONValue {
        let targets_obj = json.JSONDict()
        let keys = this.targets.keys()
        for (let i = 0; i < keys.length; i += 1) {
            let key = keys[i]
            targets_obj.put(key, this.targets[key].to_json())
        }
        
        let obj = json.JSONDict()
            .put("minimum_pm_version", json.Numeric(this.minimum_pm_version))
            .put("minimum_hoshi_build", json.Numeric(this.minimum_hoshi_build))
            .put("targets", targets_obj)
        return obj
    }
}