use str "str"
use http "net/http"
use vec "vec"
use json "json"
use time "time"
use lang "builtin"
use utils "share/utils"
use fs "fs"
use os "os"
use console "console"

enum ResultCode {
    Success,
    NotADict,
    MissingFields,
    InvalidFields,
    RequestFailed,
    InvalidResponse,
    NoAssetFound,
    CannotFindZip,
    CannotExtractZip
}

enum Platform {
    Windows,
    Linux,
    Darwin
}

struct ReleaseAsset {
    name: str.Str,
    browser_download_url: str.Str,
    content_type: str.Str,
    size: int,
    digest: str.Str,
    constructor(name: str.Str, browser_download_url: str.Str, content_type: str.Str, size: int, digest: str.Str),
    constructor(),
    static from_json(obj: json.JSONValue) : lang.Result<ReleaseAsset, ResultCode>
}

impl ReleaseAsset {
    constructor(name: str.Str, browser_download_url: str.Str, content_type: str.Str, size: int, digest: str.Str) {
        this.name = name
        this.browser_download_url = browser_download_url
        this.content_type = content_type
        this.size = size
        this.digest = digest
    },
    constructor() {
        // leave it empty
    },
    static from_json(obj: json.JSONValue) : lang.Result<ReleaseAsset, ResultCode> {
        if (obj interfaceof json.JSONDict == false) {
            return lang.Result<ReleaseAsset, ResultCode>.err(ResultCode.NotADict)
        }
        let dict = dyn_cast<json.JSONDict>(obj)
        if (dict.contains("name") == false || dict.contains("browser_download_url") == false || dict.contains("content_type") == false || dict.contains("size") == false || dict.contains("digest") == false) {
            return lang.Result<ReleaseAsset, ResultCode>.err(ResultCode.MissingFields)
        }
        let name = dyn_cast<str.Str>(dict["name"])
        let browser_download_url = dyn_cast<str.Str>(dict["browser_download_url"])
        let content_type = dyn_cast<str.Str>(dict["content_type"])
        let size = dyn_cast<json.Numeric>(dict["size"])
        let digest = dyn_cast<str.Str>(dict["digest"])
        if (name == null || browser_download_url == null || content_type == null || size == null || digest == null) {
            return lang.Result<ReleaseAsset, ResultCode>.err(ResultCode.InvalidFields)
        }
        return lang.Result<ReleaseAsset, ResultCode>.ok(ReleaseAsset(name, browser_download_url, content_type, size.getInt(), digest))
    }
}

struct ReleaseInfo {
    name: str.Str,
    tag_name: str.Str,
    assets: vec.Vec<ReleaseAsset>,
    constructor(name: str.Str, tag_name: str.Str, assets: vec.Vec<ReleaseAsset>),
    constructor(),
    static from_json(obj: json.JSONValue) : lang.Result<ReleaseInfo, ResultCode>
}

impl ReleaseInfo {
    constructor(name: str.Str, tag_name: str.Str, assets: vec.Vec<ReleaseAsset>) {
        this.name = name
        this.tag_name = tag_name
        this.assets = assets
    },
    constructor() {
        // leave it empty
    },
    static from_json(obj: json.JSONValue) : lang.Result<ReleaseInfo, ResultCode> {
        if (obj interfaceof json.JSONDict == false) {
            return lang.Result<ReleaseInfo, ResultCode>.err(ResultCode.NotADict)
        }
        let dict = dyn_cast<json.JSONDict>(obj)
        if (dict.contains("name") == false || dict.contains("tag_name") == false || dict.contains("assets") == false) {
            return lang.Result<ReleaseInfo, ResultCode>.err(ResultCode.MissingFields)
        }
        let name = dyn_cast<str.Str>(dict["name"])
        let tag_name = dyn_cast<str.Str>(dict["tag_name"])
        let assets = dyn_cast<json.JSONList>(dict["assets"])
        if (name == null || tag_name == null || assets == null) {
            return lang.Result<ReleaseInfo, ResultCode>.err(ResultCode.InvalidFields)
        }
        let assets_vec = vec.Vec<ReleaseAsset>()
        for (let i = 0;i < assets.length; i += 1) {
            let asset_result = ReleaseAsset.from_json(assets[i])
            if (asset_result.is_err()) {
                return lang.Result<ReleaseInfo, ResultCode>.err(asset_result.unwrap_err())
            }
            assets_vec.push(asset_result.unwrap())
        }
        return lang.Result<ReleaseInfo, ResultCode>.ok(ReleaseInfo(name, tag_name, assets_vec))
    }
}

func get_releases() : lang.Result<vec.Vec<ReleaseInfo>, ResultCode> {
    let url : str.Str = "https://api.github.com/repos/XtherDevTeam/hoshi-lang-stdlib/releases"
    utils.share_context.logger.log(str.format("Fetching releases from {}", url))
    let req = http.open("GET", url)
    if (req.is_err()) {
        return lang.Result<vec.Vec<ReleaseInfo>, ResultCode>.err(ResultCode.RequestFailed)
    }
    let resp = req.unwrap().send()
    if (resp.is_err()) {
        return lang.Result<vec.Vec<ReleaseInfo>, ResultCode>.err(ResultCode.RequestFailed)
    }
    let body = resp.unwrap().text()
    let json_obj = json.parse(body.unwrap())
    if (json_obj.is_err() || json_obj.unwrap() interfaceof json.JSONList == false) {
        return lang.Result<vec.Vec<ReleaseInfo>, ResultCode>.err(ResultCode.InvalidResponse)
    }
    let json_list = dyn_cast<json.JSONList>(json_obj.unwrap())
    let releases_vec = vec.Vec<ReleaseInfo>()
    for (let i = 0;i < json_list.length; i += 1) {
        let release_result = ReleaseInfo.from_json(json_list[i])
        if (release_result.is_err()) {
            return lang.Result<vec.Vec<ReleaseInfo>, ResultCode>.err(release_result.unwrap_err())
        }
        releases_vec.push(release_result.unwrap())
    }
    return lang.Result<vec.Vec<ReleaseInfo>, ResultCode>.ok(releases_vec)
}

func download_release(release: ReleaseInfo, dest_dir: str.Str) : ResultCode {
    [[platform == "win32"]] let asset_name = "hoshi-lang-windows-clang.zip"
    [[platform == "linux"]] let asset_name = "hoshi-lang-linux.zip"
    [[platform == "darwin"]] let asset_name = "hoshi-lang-darwin.zip"
    let url : str.Str = ""
    for (let i = 0;i < release.assets.length; i += 1) {
        if (release.assets[i].name == asset_name) {
            url = release.assets[i].browser_download_url
        }
    }
    if (url == "") {
        return ResultCode.NoAssetFound
    }
    utils.share_context.logger.log(str.format("Downloading release from {}", url))
    let p = fs.Path(dest_dir) / "hoshi-lang.zip"
    if (utils.save_stream(url, p.to_string()) != utils.ResultCode.Success) {
        return ResultCode.RequestFailed
    }
    return ResultCode.Success
}

func extract_release(src_file: str.Str, dest_dir: str.Str) : ResultCode {
    [[platform == "win32"]] let asset_name = "hoshi-lang-windows-clang"
    [[platform == "linux"]] let asset_name = "hoshi-lang-linux"
    [[platform == "darwin"]] let asset_name = "hoshi-lang-darwin"
    let p = fs.Path(src_file)
    if (p.exists() == false) {
        return ResultCode.CannotFindZip
    }
    if (utils.extract_zipfile(p.to_string(), dest_dir) != utils.ResultCode.Success) {
        return ResultCode.CannotExtractZip
    }
    p = fs.Path(dest_dir) / asset_name
    utils.share_context.logger.log(str.format("Extracting release to {}", p.to_string()))
    // move all files in it to dest_dir
    let assets = p.listdir()
    for (let i = 0;i < assets.length; i += 1) {
        assets[i].move(fs.Path(dest_dir) / assets[i].filename())
    }
    p.remove()
    if (p.exists()) {
        return ResultCode.CannotExtractZip
    }
    fs.Path(src_file).remove()
    return ResultCode.Success
}

func detect_existing_hoshi_installation() : str.Str {
    let result_str : str.Str = ""
    if (os.environ.contains("HOSHI_HOME")) {
        result_str = os.environ["HOSHI_HOME"]
    } else {
        let process = os.popen("hoshi_lang -w", "r")
        if (process.is_err()) {
            return ""
        }
        let buffer = process.unwrap().read(2048)
        result_str = str.Str(buffer.data).trim()
    }
    
    let p = fs.Path(result_str)
    if (p.stem() == "bin") {
        return p.parent().to_string()
    } else {
        return p.to_string()
    }
}

enum ShellEnvironmentType {
    Pwsh,
    Bash,
    Zsh,
    Unknown
}

func detect_shell_environment() : ShellEnvironmentType {
    let shell_name = os.environ["SHELL"]
    if (shell_name.find("pwsh") != -1) {
        return ShellEnvironmentType.Pwsh
    } elif (shell_name.find("bash") != -1) {
        return ShellEnvironmentType.Bash
    } elif (shell_name.find("zsh") != -1) {
        return ShellEnvironmentType.Zsh
    } else {
        return ShellEnvironmentType.Unknown
    }
}

func modify_env(dest_dir: str.Str) : bool {
    let d_path = fs.Path(dest_dir)
    let b_path = d_path / "bin"
    let shell_type = detect_shell_environment()
    if (shell_type == ShellEnvironmentType.Pwsh) {
        os.system(str.format("powershell -Command \"{}\"", str.escape(
            str.format("[Environment]::SetEnvironmentVariable(\"PATH\", $Env:PATH + \";{}\", [EnvironmentVariableTarget]::User)", b_path.to_string())
        )))
        os.system(str.format("powershell -Command \"{}\"", str.escape(
            str.format("[Environment]::SetEnvironmentVariable(\"HOSHI_HOME\", \"{}\", [EnvironmentVariableTarget]::User)", d_path.to_string())
        )))
        return true
    } elif (shell_type == ShellEnvironmentType.Bash) {
        let profile_path = fs.Path.home_dir() / ".bashrc"
        let fp = fs.open(profile_path.to_string(), "a")
        if (fp.is_err()) {
            utils.share_context.logger.error(str.format("Failed to open {} for appending", profile_path))
            return false
        } else {
            let fp = fp.unwrap()
            fp.write(str.Str("# begin hoshi-lang\n").data)
            fp.write(str.format("export PATH=$PATH:{}\n", b_path.to_string()).data)
            fp.write(str.format("export HOSHI_HOME={}\n", d_path.to_string()).data)
            fp.write(str.Str("# end hoshi-lang\n").data)
            fp.close()
            return true
        }
    } elif (shell_type == ShellEnvironmentType.Zsh) {
        let profile_path = fs.Path.home_dir() / ".zshrc"
        let fp = fs.open(profile_path.to_string(), "a")
        if (fp.is_err()) {
            utils.share_context.logger.error(str.format("Failed to open {} for appending", profile_path))
            return false
        } else {
            let fp = fp.unwrap()
            fp.write(str.Str("# begin hoshi-lang\n").data)
            fp.write(str.format("export PATH=$PATH:{}\n", b_path.to_string()).data)
            fp.write(str.format("export HOSHI_HOME={}\n", d_path.to_string()).data)
            fp.write(str.Str("# end hoshi-lang\n").data)
            fp.close()
            return true
        }
    } else {
        return false
    }
}

func remove_existing_installation() : bool {
    let existing_installation = detect_existing_hoshi_installation()
    if (existing_installation == "") {
        utils.share_context.logger.warn("No existing installation found")
        return false
    }
    console.print("Removing existing installation at {}\n", existing_installation)
    let p = fs.Path(existing_installation)
    if (p.exists() == false) {
        utils.share_context.logger.warn("Installation directory does not exist")
        return true
    }
    if (p.remove(true) == false) {
        utils.share_context.logger.error("Failed to remove installation directory")
        return false
    }
    return true
}

func installer(version: str.Str, dest_dir: str.Str) : str.Str {
    let existing_installation = detect_existing_hoshi_installation()
    if (existing_installation != "") {
        utils.share_context.logger.warn(str.format("Found existing installation at {}", existing_installation))
        return existing_installation
    }
    console.print("Beginning hoshi-lang installation...\n")
    utils.share_context.logger.log("Querying available releases")
    let releases = get_releases()
    if (releases.is_err()) {
        utils.share_context.logger.error(str.format("Failed to get releases: {}", releases.unwrap_err()))
        return ""
    }
    if (releases.unwrap().length == 0) {
        utils.share_context.logger.error("No releases found")
        return ""
    }
    if (version == "") {
        console.print("Sucessfully required release information, available releases:\n")
        for (let i = 0; i < releases.unwrap().length && i < 10; i += 1) {
            console.print(i, ":",  releases.unwrap()[i].name, "(", releases.unwrap()[i].tag_name, ")\n")
        }
        version = console.input(str.format("Select a release to install ({}): ", releases.unwrap()[0].tag_name)).trim()
        if (version == "") {
            version = releases.unwrap()[0].tag_name
        }
    }
    if (dest_dir == "") {
        let d = fs.Path.home_dir() / ".hoshi"
        dest_dir = console.input(str.format("Enter installation directory (default: {}):", d.to_string())).trim()
        if (dest_dir == "") {
            dest_dir = d.to_string()
        }
    }
    let release_found = -1
    for (let i = 0; i < releases.unwrap().length; i += 1) {
        if (releases.unwrap()[i].tag_name == version) {
            release_found = i
            break
        }
    }
    if (release_found == -1) {
        utils.share_context.logger.error(str.format("Release {} not found", version))
        return ""
    }
    let release = releases.unwrap()[release_found]
    console.print(str.format("Installing release {} ({}), this may take a while...\n", release.name, release.tag_name))
    let temp_dir = fs.Path.temp_dir()
    let dest_dir_path = fs.Path(dest_dir)
    if (dest_dir_path.exists() == false) {
        if (dest_dir_path.mkdir(true) == false) {
            utils.share_context.logger.error(str.format("Failed to create directory {}", dest_dir))
            return ""
        }
    }
    if (download_release(release, temp_dir.to_string()) != ResultCode.Success) {
        utils.share_context.logger.error("failed to download release asset\n")
        return 1
    }
    utils.share_context.logger.log("successfully downloaded release asset\n")
    if (extract_release(temp_dir.to_string() + "/hoshi-lang.zip", dest_dir) != ResultCode.Success) {
        utils.share_context.logger.error("failed to extract release asset\n")
        return 1
    }
    utils.share_context.logger.log("successfully downloaded and extracted release asset\n")
    [[platform != "win32"]] os.chmod(dest_dir + "/bin/hoshi_lang", 0o755)
    let hoshi_bin = fs.Path(dest_dir) / "bin"
    console.print(str.format("Successfully installed hoshi-lang to {}\n", dest_dir))
    if (modify_env(dest_dir) == false) {
        console.print("You may need to set up your shell environment manually:\nFor HOSHI_HOME, set to {}\nFor PATH, add {}\n", dest_dir, hoshi_bin)
    } else {
        console.print("You may need to restart your shell for changes to take effect\n")
    }
    return dest_dir
}

func updater(version: str.Str, force: bool) : int {
    let existing_installation = detect_existing_hoshi_installation()
    if (existing_installation == "") {
        utils.share_context.logger.error("No existing hoshi installation found to update. Use 'installer' instead.")
        return 1
    }
    let dest_dir = existing_installation
    console.print(str.format("Updating hoshi-lang installation at {}...\n", dest_dir))

    utils.share_context.logger.log("Querying available releases")
    let releases_res = get_releases()
    if (releases_res.is_err()) {
        utils.share_context.logger.error(str.format("Failed to get releases: {}", releases_res.unwrap_err()))
        return 1
    }
    let releases = releases_res.unwrap()
    if (releases.length == 0) {
        utils.share_context.logger.error("No releases found")
        return 1
    }

    if (version == "") {
        if (force == false) {
            console.print("Successfully acquired release information, available releases:\n")
            for (let i = 0; i < releases.length && i < 10; i += 1) {
                console.print(i, ":",  releases[i].name, "(", releases[i].tag_name, ")\n")
            }
            version = console.input(str.format("Select a release to install ({}): ", releases[0].tag_name)).trim()
            if (version == "") {
                version = releases[0].tag_name
            }
        } else {
            version = releases[0].tag_name
        }
    }

    let release_found = -1
    for (let i = 0; i < releases.length; i += 1) {
        if (releases[i].tag_name == version) {
            release_found = i
            break
        }
    }
    if (release_found == -1) {
        utils.share_context.logger.error(str.format("Release {} not found", version))
        return 1
    }

    let release = releases[release_found]
    console.print(str.format("Updating to release {} ({}), this may take a while...\n", release.name, release.tag_name))

    let temp_dir_path = fs.Path.temp_dir() / "hoshi-update"
    let temp_dir = temp_dir_path.to_string()
    if (temp_dir_path.exists()) {
        temp_dir_path.remove(true)
    }
    temp_dir_path.mkdir(true)

    if (download_release(release, temp_dir) != ResultCode.Success) {
        utils.share_context.logger.error("Failed to download release asset\n")
        return 1
    }
    
    let zip_file = temp_dir_path / "hoshi-lang.zip"
    let extract_dir_path = temp_dir_path / "extracted"
    let extract_dir = extract_dir_path.to_string()
    extract_dir_path.mkdir(true)

    if (extract_release(zip_file.to_string(), extract_dir) != ResultCode.Success) {
        utils.share_context.logger.error("Failed to extract release asset\n")
        return 1
    }

    // Hot-swap: rename old installation to backup, then move new one in.
    let backup_dir = fs.Path(dest_dir + ".bak")
    if (backup_dir.exists()) {
        backup_dir.remove(true)
    }

    console.print("Replacing files...\n")
    
    let dest_path = fs.Path(dest_dir)
    if (dest_path.move(backup_dir) == false) {
        utils.share_context.logger.error("Failed to backup existing installation. It might be in use.")
        return 1
    }

    if (extract_dir_path.move(dest_path) == false) {
        utils.share_context.logger.error("Failed to move new installation to destination.")
        // Try to restore backup
        backup_dir.move(dest_path)
        return 1
    }

    [[platform != "win32"]] os.chmod(dest_dir + "/bin/hoshi_lang", 0o755)
    [[platform != "win32"]] os.chmod(dest_dir + "/bin/pardo", 0o755)

    console.print(str.format("Successfully updated hoshi-lang installation at {}\n", dest_dir))
    backup_dir.remove(true)
    
    return 0
}