+// /v1/user/search
+func route_user_search(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
+    let [body_json, err] = req.json()
+    if (err != null) { return make_error_response("invalid request: error parsing json") }
+    let body = dyn_cast<json.JSONDict>(body_json)
+
+    let query_cond = types.UserQueryCondition()
+    let range_cond = types.GeneralRangeCondition()
+
+    if (body.contains("query")) {
+        let q = dyn_cast<json.JSONDict>(body["query"])
+        if (q.contains("username")) {
+            query_cond.set_username_like(dyn_cast<str.Str>(q["username"]))
+        }
+        if (q.contains("email")) {
+            query_cond.set_email_like(dyn_cast<str.Str>(q["email"]))
+        }
+    }
+
+    if (body.contains("range")) {
+        let r = dyn_cast<json.JSONDict>(body["range"])
+        if (r.contains("page_size")) {
+            let ps = dyn_cast<json.Numeric>(r["page_size"])
+            range_cond.set_page_size(ps.getInt())
+        } else {
+            range_cond.set_page_size(10)
+        }
+        if (r.contains("page_offset")) {
+            let po = dyn_cast<json.Numeric>(r["page_offset"])
+            range_cond.set_page_offset(po.getInt())
+        } else {
+            range_cond.set_page_offset(0)
+        }
+    }
+
+    let [users, u_err] = data_provider.search_users(query_cond, range_cond)
+    if (u_err != null) {
+        return make_error_response("search failed")
+    }
+
+    let list = json.JSONList()
+    for (let i = 0; i < users.length; i += 1) {
+        let u = users[i]
+        // RETURN SAFE PUBLIC INFO ONLY
+        list.push(json.JSONDict()
+            .put("id", json.Numeric(u.id))
+            .put("username", u.username)
+            .put("description", u.description)
+            .put("permission", json.Numeric(u.permission)) as json.JSONValue
+        )
+    }
+
+    return kiana.response.Response(
+        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
+        json.JSONDict()
+            .put("status", str.Str("ok"))
+            .put("data", list) as json.JSONValue
+    )
+}
+
