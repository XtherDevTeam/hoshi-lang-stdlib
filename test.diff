+// /v1/user/profile/:id
+func route_user_public_profile(req: kiana.request.Request, params: hashMap.HashMap<str.Str, str.Str>) : kiana.response.Response {
+    if (params.contains("id") == false) {
+        return make_error_response("missing user id")
+    }
+    let id_str = params["id"]
+    let id = str.toInt(id_str)
+    
+    let [user, err] = data_provider.get_user_by_id(id)
+    if (err != null) {
+        return make_error_response("user not found")
+    }
+
+    // Return safe public info only
+    return kiana.response.Response(
+        http.HTTPResponseHeader("HTTP/1.1", 200, "OK"),
+        json.JSONDict()
+            .put("status", str.Str("ok"))
+            .put("data", json.JSONDict()
+                .put("id", json.Numeric(user.id))
+                .put("username", user.username)
+                .put("description", user.description)
+            ) as json.JSONValue
+    )
+}
